From 4349c0501533bd3bcc012d66d6a6101b3a873d96 Mon Sep 17 00:00:00 2001
From: "Nathanial P. Howard" <admin@optimuspi.com>
Date: Fri, 15 May 2026 13:07:10 -0500
Subject: [PATCH 3/3] fix(publish): unwrap Task<T> before instanced surface
 inspection

SurfaceInspector.InspectType called InspectInstance with the wrapping
Task<T> type when the value's TypeMeta resolved to instanced. That registered
Task<T> itself as an InstanceMeta surface and recursed into Task<T>'s public
instance methods (GetAwaiter, ConfigureAwait, Equals, GetHashCode, ToString),
pulling ConfiguredTaskAwaitable<T> and TaskAwaiter<T> into the inspection
as their own "user" instances and emitting a JSConfiguredTaskAwaitable`1
wrapper class. The backtick-arity in the C# identifier is invalid syntax;
even if it parsed, the wrapper would expose Equals/GetAwaiter/etc. as
JS-callable, which violates the documented contract.

Contract:
- docs/guide/interop-instances.md: "Only user types are subject to instance
  binding. BCL types are ignored to prevent leaking the entire .NET runtime
  into the generated interop layer."
- docs/guide/serialization.md: tasks (promises) are natively marshalled;
  they are not values that get inspected as types.
- Bootsharp.Publish/Common/Inspection/SerializedInspector.cs already does
  the same unwrap: `if (IsTaskWithResult(type, out var result)) type = result;
  // tasks are natively supported - ignore them`.

Mirror that idiom in SurfaceInspector.InspectType with a `while` loop (handles
Task<Task<X>>). The unwrapped type still flows into IsInstanced + InspectInstance;
the outer Task wrapper survives via ValueMeta.TypeSyntax (built from the original
type before InspectType's local is reassigned), so the C# signature on the
generated proxy still reads Task<X>. EmitMethodImport already expects this:
the inner type drives the marshal decision, the outer Task drives the
async-await emission at the call site.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 src/cs/Bootsharp.Publish/Common/Inspection/SurfaceInspector.cs | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/cs/Bootsharp.Publish/Common/Inspection/SurfaceInspector.cs b/src/cs/Bootsharp.Publish/Common/Inspection/SurfaceInspector.cs
index ca3a29b..04d9713 100644
--- a/src/cs/Bootsharp.Publish/Common/Inspection/SurfaceInspector.cs
+++ b/src/cs/Bootsharp.Publish/Common/Inspection/SurfaceInspector.cs
@@ -26,6 +26,7 @@ internal class SurfaceInspector (InstancedInspector itd, SerializedInspector srd
 
     private TypeMeta InspectType (Type type, InteropKind ik)
     {
+        while (IsTaskWithResult(type, out var result)) type = result;
         if (IsInstanced(type)) InspectInstance(type, ik);
         return itd.Inspect(type) ?? srd.Inspect(type) ?? new TypeMeta(type);
     }
-- 
