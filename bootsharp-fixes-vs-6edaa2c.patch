From 65af54bd57e0139046750ce2a9ad7216de95dfb5 Mon Sep 17 00:00:00 2001
From: "Nathanial P. Howard" <admin@optimuspi.com>
Date: Fri, 15 May 2026 13:06:23 -0500
Subject: [PATCH 1/3] fix(publish): migrate TypeDeclarationGenerator to new
 Surfaces/Types split

The refactor at 6edaa2c moved SolutionInspection's per-kind collections
(Instanced, Serialized, Modules, Static) under a single Surfaces collection
plus a flat Types collection, but TypeDeclarationGenerator.CollectMetas
still referenced the old SolutionInspection.Instanced shape and InstancedMeta.Members
(members are now on the InstanceMeta surface, not the InstancedMeta type).

Without this Bootsharp.Publish does not compile, so the rest of the changes
in this branch are unreachable.

- Build the metaByClr map from spec.Surfaces.OfType<InstanceMeta>().Src
  plus spec.Types.OfType<SerializedMeta>().
- Add a Dictionary<Type, InstanceMeta> surfaceByClr keyed on the CLR type
  (record-equality on InstancedMeta isn't reliable here since the two
  construction sites in SurfaceInspector and InstancedInspector set
  different Exporter/Importer values).
- DeclareInstanced reads members via surfaceByClr[it.Clr].Members.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 .../DeclarationGenerator/TypeDeclarationGenerator.cs  | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/src/cs/Bootsharp.Publish/Pack/DeclarationGenerator/TypeDeclarationGenerator.cs b/src/cs/Bootsharp.Publish/Pack/DeclarationGenerator/TypeDeclarationGenerator.cs
index 6c451a1..388f713 100644
--- a/src/cs/Bootsharp.Publish/Pack/DeclarationGenerator/TypeDeclarationGenerator.cs
+++ b/src/cs/Bootsharp.Publish/Pack/DeclarationGenerator/TypeDeclarationGenerator.cs
@@ -10,13 +10,18 @@ internal sealed class TypeDeclarationGenerator (TypeSyntaxBuilder ts)
 
     private DocumentationBuilder docs = null!;
     private readonly Dictionary<Type, TypeMeta> metaByClr = [];
+    private readonly Dictionary<Type, InstanceMeta> surfaceByClr = [];
 
     public IReadOnlyDictionary<Type, TypeMeta> CollectMetas (SolutionInspection spec)
     {
         docs = new(spec.Docs);
         metaByClr.Clear();
-        foreach (var meta in spec.Instanced)
-            metaByClr[meta.Clr] = meta;
+        surfaceByClr.Clear();
+        foreach (var surface in spec.Surfaces.OfType<InstanceMeta>())
+        {
+            metaByClr[surface.Src.Clr] = surface.Src;
+            surfaceByClr[surface.Src.Clr] = surface;
+        }
         foreach (var meta in spec.Types.OfType<SerializedMeta>())
             if (IsUserType(meta.Clr))
                 metaByClr.TryAdd(meta.Clr, meta);
@@ -108,7 +113,7 @@ internal sealed class TypeDeclarationGenerator (TypeSyntaxBuilder ts)
         AppendLine($"export interface {ts.BuildName(it.Clr)}", indent);
         AppendExtensions();
         bld.Append(" {");
-        foreach (var member in it.Members)
+        foreach (var member in surfaceByClr[it.Clr].Members)
             if (!ShouldDeclareOn(it.Clr, member.Info)) continue;
             else if (member is EventMeta evt) AppendEvent(evt);
             else if (member is PropertyMeta prop) AppendProperty(prop);
-- 
2.53.0.windows.3


From bc3a5a0b805aeeaddc431f76c69e8314ef83d9fa Mon Sep 17 00:00:00 2001
From: "Nathanial P. Howard" <admin@optimuspi.com>
Date: Fri, 15 May 2026 13:06:49 -0500
Subject: [PATCH 2/3] fix(publish): qualify root Bootsharp namespace in
 instance proxy emission

Two related issues in the InstanceGenerator template, both surfacing only when
the consuming assembly uses an interface whose namespace starts with Bootsharp
(e.g. Bootsharp.FileSystem.IFileSystem):

1. Namespace shadowing. The generated wrapper for an instanced import lives
   in a namespace like `Bootsharp.Generated.Imports.Bootsharp.FileSystem`.
   From inside that scope, bare `Bootsharp.Instances.*` and
   `Bootsharp.JSImported(...)` references in the template bind to the
   innermost matching `Bootsharp.Generated.Imports.Bootsharp` namespace,
   not the runtime `Bootsharp` root. Result: `error CS0234: 'JSImported'
   does not exist in the namespace 'Bootsharp.Generated.Imports.Bootsharp'`.
   Force the root with `global::Bootsharp.*` everywhere it's emitted.

2. Symbol rename. Commit 097c0a1 (and the cleaned-up 6edaa2c) renamed
   `Bootsharp.JSImported` to `Bootsharp.JSProxy` on the Common runtime side,
   but the InstanceGenerator template wasn't updated. With (1) fixed the
   emission becomes `global::Bootsharp.JSImported(id)`, which fails with
   CS0234 because the symbol no longer exists. Rename in the template to
   match the runtime API.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 src/cs/Bootsharp.Publish/Emit/InstanceGenerator.cs | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/src/cs/Bootsharp.Publish/Emit/InstanceGenerator.cs b/src/cs/Bootsharp.Publish/Emit/InstanceGenerator.cs
index 9b888e2..a7697a7 100644
--- a/src/cs/Bootsharp.Publish/Emit/InstanceGenerator.cs
+++ b/src/cs/Bootsharp.Publish/Emit/InstanceGenerator.cs
@@ -19,14 +19,14 @@ internal sealed class InstanceGenerator
           {
               public static partial class Instances
               {
-                  internal static int Export<T> (T it, Bootsharp.Instances.ExportCallback<T>? cb = null) where T : class => Bootsharp.Instances.Export(it, cb);
-                  internal static T Exported<T> (int id) where T : class => Bootsharp.Instances.Exported<T>(id);
-                  internal static T Resolve<T> (int id) where T : class => Bootsharp.Instances.Resolve<T>(id);
+                  internal static int Export<T> (T it, global::Bootsharp.Instances.ExportCallback<T>? cb = null) where T : class => global::Bootsharp.Instances.Export(it, cb);
+                  internal static T Exported<T> (int id) where T : class => global::Bootsharp.Instances.Exported<T>(id);
+                  internal static T Resolve<T> (int id) where T : class => global::Bootsharp.Instances.Resolve<T>(id);
 
                   internal static void DisposeImported (int id)
                   {
                       NotifyImportedDisposed(id);
-                      Bootsharp.Instances.DisposeImported(id);
+                      global::Bootsharp.Instances.DisposeImported(id);
                   }
 
                   [ModuleInitializer]
@@ -37,7 +37,7 @@ internal sealed class InstanceGenerator
 
                   {{Fmt(its.Where(i => i.Src.Exporter != null).Select(EmitExporter), 2, "\n\n")}}
 
-                  [JSExport] private static void DisposeExported (int id) => Bootsharp.Instances.DisposeExported(id);
+                  [JSExport] private static void DisposeExported (int id) => global::Bootsharp.Instances.DisposeExported(id);
                   [JSImport("instances.disposeImported", "Bootsharp")] private static partial void NotifyImportedDisposed (int id);
               }
           }
@@ -48,7 +48,7 @@ internal sealed class InstanceGenerator
     private static string EmitImporter (InstanceMeta it)
     {
         var proxy = $"static id => new {it.Proxy.Syntax}(id)";
-        return $"Bootsharp.Instances.RegisterImport(typeof({it.Src.Syntax}), {proxy});";
+        return $"global::Bootsharp.Instances.RegisterImport(typeof({it.Src.Syntax}), {proxy});";
     }
 
     private static string EmitExporter (InstanceMeta it)
@@ -76,7 +76,7 @@ internal sealed class InstanceGenerator
         $$"""
           namespace {{(this.it = it).Proxy.Space}}
           {
-              public class {{it.Proxy.Name}} (int id) : Bootsharp.JSImported(id), {{it.Src.Syntax}}
+              public class {{it.Proxy.Name}} (int id) : global::Bootsharp.JSProxy(id), {{it.Src.Syntax}}
               {
                   ~{{it.Proxy.Name}}() => Instances.DisposeImported(_id);
 
