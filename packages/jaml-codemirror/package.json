{
  "name": "jaml-codemirror",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "CodeMirror 6 language support for JAML with diagnostics and completions.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build && tsc -p . --emitDeclarationOnly",
    "typecheck": "tsc --noEmit -p .",
    "watch": "tsc -p . --watch"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.5",
    "@uiw/react-codemirror": "^4.23.10",
    "motely-wasm": "^23.3.0",
    "react": "^19.2.6",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "files": [
    "dist"
  ]
}
