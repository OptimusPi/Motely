{
  "name": "jaml-language-support",
  "displayName": "Jimbo's Ante Markup Language",
  "description": "JAML language support for Motely: highlighting, snippets, diagnostics, schema access, and editor commands.",
  "version": "1.4.0",
  "publisher": "pifreak",
  "license": "MIT",
  "author": "pifreak <nate@optimuspi.com>",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "balatro",
    "jaml",
    "jummy",
    "motely",
    "seed",
    "seedfinder"
  ],
  "icon": "images/icon.ico",
  "galleryBanner": {
    "color": "#22142f",
    "theme": "dark"
  },
  "homepage": "https://github.com/OptimusPi/MotelyJAML#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptimusPi/MotelyJAML.git",
    "directory": "packages/jaml-language-support"
  },
  "bugs": {
    "url": "https://github.com/OptimusPi/MotelyJAML/issues"
  },
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jaml",
        "aliases": [
          "JAML",
          "Jimbo's Ante Markup Language"
        ],
        "extensions": [
          ".jaml"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/icon.ico",
          "dark": "./images/icon.ico"
        }
      },
      {
        "id": "jummy",
        "aliases": [
          "Jummy"
        ],
        "extensions": [
          ".jummy"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/icon.ico",
          "dark": "./images/icon.ico"
        }
      }
    ],
    "grammars": [
      {
        "language": "jaml",
        "scopeName": "source.jaml",
        "path": "./syntaxes/jaml.tmLanguage.json"
      },
      {
        "language": "jummy",
        "scopeName": "source.jummy",
        "path": "./syntaxes/jummy.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "jaml",
        "path": "./snippets/jaml.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "jaml.showDocumentSummary",
        "title": "JAML: Show Document Summary",
        "category": "JAML"
      },
      {
        "command": "jaml.openSchema",
        "title": "JAML: Open Bundled Schema",
        "category": "JAML"
      },
      {
        "command": "jaml.openInCurator",
        "title": "JAML: Open in Seed Curator",
        "category": "JAML",
        "icon": "$(search)"
      },
      {
        "command": "jaml.analyzeSeed",
        "title": "JAML: Analyze Seed",
        "category": "JAML",
        "icon": "$(beaker)"
      }
    ],
    "chatParticipants": [
      {
        "id": "jaml.jimbo",
        "name": "jimbo",
        "fullName": "Jimbo (JAML Assistant)",
        "description": "Ask Jimbo about JAML filters and Balatro seeds. Connects to the Balatro Seed Curator.",
        "isSticky": false,
        "commands": [
          { "name": "explain", "description": "Explain the current .jaml filter in plain English" },
          { "name": "analyze", "description": "Analyze a Balatro seed (select one or type it)" },
          { "name": "search", "description": "Quickly scan for seeds matching this filter and show a data table" }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "jaml.showDocumentSummary",
          "when": "resourceLangId == jaml",
          "group": "navigation"
        },
        {
          "command": "jaml.openInCurator",
          "when": "resourceLangId == jaml",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "jaml.analyzeSeed",
          "when": "editorHasSelection",
          "group": "jaml"
        }
      ],
      "commandPalette": [
        {
          "command": "jaml.showDocumentSummary",
          "when": "resourceLangId == jaml"
        },
        {
          "command": "jaml.openSchema"
        },
        {
          "command": "jaml.openInCurator",
          "when": "resourceLangId == jaml"
        },
        {
          "command": "jaml.analyzeSeed"
        }
      ]
    }
  },
  "files": [
    "README.md",
    "LICENSE.txt",
    "package.json",
    "language-configuration.json",
    "out/**",
    "syntaxes/**",
    "snippets/**",
    "schema/**",
    "images/**",
    "vendor/**"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "dev": "node esbuild.mjs --watch",
    "vendor": "node ./scripts/vendor.mjs",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node ./scripts/vendor.mjs && node esbuild.mjs && node ./scripts/prepublish-check.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "latest",
    "esbuild": "^0.25.0"
  }
}