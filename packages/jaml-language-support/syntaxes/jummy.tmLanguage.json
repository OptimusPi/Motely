{
  "scopeName": "source.jummy",
  "name": "Jummy",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#strings" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "#.*$",
          "name": "comment.line.number-sign.jummy"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(Ante|ante|Boss|boss|Joker|joker|Voucher|voucher|Tag|tag|Eternal|Perishable|Rental|Negative|Foil|Holographic|Polychrome|Blueprint|Brainstorm|Perkeo|Triboulet|Canio|Yorick|Chicot|Soul|Spectral|Arcana|Buffoon)\\b",
          "name": "keyword.other.jummy"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_])-?\\d+(?:\\.\\d+)?(?![A-Za-z0-9_])",
          "name": "constant.numeric.jummy"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.jummy"
        }
      ]
    }
  }
}
