{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JAML",
  "scopeName": "source.jaml",
  "fileTypes": ["jaml"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#jummyLine" },
    { "include": "#jamlKey" },
    { "include": "#string" },
    { "include": "#constant" },
    { "include": "#number" },
    { "include": "#listMarker" },
    { "include": "#operators" }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.jaml"
    },
    "jamlKey": {
      "match": "^\\s*((?:id|name|description|author|dateCreated|deck|stake|seeds|must|should|mustNot|and|or|clauses|ante|antes|min|max|score|label|sources|with|luck|vouchers|joker|jokers|commonJoker|commonJokers|uncommonJoker|uncommonJokers|rareJoker|rareJokers|legendaryJoker|legendaryJokers|edition|stickers|shopItems|boosterPacks|arcanaPacks|spectralPacks|soulCard|requireMega|requireMegaPack|standardCard|rank|suit|enhancement|seal|startingDraw|soulCardOnly|soulEditionRolls|luckyMoney|luckyMult|misprintMult|wheelOfFortune|grosMichelExtinct|cavendishExtinct|spaceLevelup|businessPayout|bloodstoneTrigger|parkingPayout|glassDestroy|wheelStaysFlipped|rolls|mult|value|judgement|emperor|wraith|riffRaff|rareTag|uncommonTag|commonShopJokers|uncommonShopJokers|rareShopJokers|allShopJokers|purpleSealOrEightBall|charmTag|sixthSense|seance|etherealTag|certificate|incantation|familiar|grim|deckDraw))\\s*:",
      "captures": {
        "1": { "name": "keyword.control.jaml" }
      }
    },
    "jummyLine": {
      "match": "^\\s*-\\s*(Eternal|Perishable|Rental|Foil|Holographic|Polychrome|Negative|Any|Voucher|Tag|Small Blind Tag|Big Blind Tag|Boss|Starting Draw|Lucky Money|Lucky Mult|Misprint Mult|Wheel of Fortune|Gros Michel Extinct|Cavendish Extinct|Space Levelup|Glass Destroy|Wheel Stays Flipped|Business Payout|Bloodstone Trigger|Parking Payout)?.*?(\\bin ante\\b|\\bin antes\\b|\\bor\\b|\\brolls\\b|\\bwith luck\\b)?.*$",
      "captures": {
        "1": { "name": "entity.name.function.jaml" },
        "2": { "name": "keyword.control.jaml" }
      }
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.jaml",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.jaml", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.jaml",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.jaml", "match": "\\\\." }
          ]
        }
      ]
    },
    "constant": {
      "match": "\\b(true|false|null|~|True|False|Null)\\b",
      "name": "constant.language.jaml"
    },
    "number": {
      "match": "\\b[+-]?\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b",
      "name": "constant.numeric.jaml"
    },
    "listMarker": {
      "match": "^\\s*(-)\\s+",
      "captures": {
        "1": { "name": "punctuation.definition.list.begin.jaml" }
      }
    },
    "operators": {
      "match": "[|>:-]",
      "name": "keyword.operator.jaml"
    }
  }
}
