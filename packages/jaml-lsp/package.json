{
  "name": "jaml-lsp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal Language Server Protocol server for JAML (Jimbo's Ante Markup Language).",
  "bin": {
    "jaml-lsp": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "start": "node ./dist/server.js --stdio"
  },
  "dependencies": {
    "motely-wasm": "^23.3.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
