<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
    <!-- componentize-dotnet: NativeAOT-LLVM → standalone .wasm -->
    <PackageReference Include="BytecodeAlliance.Componentize.DotNet.Wasm.SDK" />
    <PackageReference Include="runtime.win-x64.microsoft.dotnet.ilcompiler.llvm" />
  </ItemGroup>

  <!-- Post-build: Copy .wasm to NPM package -->
  <Target Name="CopyToNpm" AfterTargets="Build">
    <PropertyGroup>
      <_NpmWasmPath>$(MSBuildThisFileDirectory)..\Motely-WASI.NPM\wasm</_NpmWasmPath>
    </PropertyGroup>
    <MakeDir Directories="$(_NpmWasmPath)" Condition="!Exists('$(_NpmWasmPath)')" />
    <ItemGroup>
      <_WasmOutputFiles Include="$(OutputPath)publish\**\*.wasm" />
    </ItemGroup>
    <Copy SourceFiles="@(_WasmOutputFiles)"
          DestinationFolder="$(_NpmWasmPath)"
          SkipUnchangedFiles="true"
          Condition="'@(_WasmOutputFiles)' != ''" />
  </Target>
</Project>
