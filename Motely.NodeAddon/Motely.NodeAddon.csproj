<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>$(MotelyVersion)</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Motely.NodeAddon</RootNamespace>
    <AssemblyName>Motely.NodeAddon</AssemblyName>
    <Description>Node.js addon for Motely (node-api-dotnet AOT).</Description>
    <!-- Per https://microsoft.github.io/node-api-dotnet/scenarios/js-aot-module.html -->
    <PublishAot>true</PublishAot>
    <PublishNodeModule>true</PublishNodeModule>
    <PublishMultiPlatformNodeModule>true</PublishMultiPlatformNodeModule>
    <PublishDir>$(MSBuildProjectDirectory)\bin</PublishDir>
    <PackNpmPackage>true</PackNpmPackage>
    <PackageOutputPath>$(MSBuildProjectDirectory)\pkg</PackageOutputPath>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- No libicu needed; smaller image, fewer deps, perf tip -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Default to win-x64 Release on Windows when not specified -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' AND '$([MSBuild]::IsOSPlatform(Windows))' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == ''">
    <Configuration>Release</Configuration>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.JavaScript.NodeApi" />
    <PackageReference Include="Microsoft.JavaScript.NodeApi.Generator" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
    <ProjectReference Include="..\Motely.Orchestration\Motely.Orchestration.csproj" />
  </ItemGroup>

  <!-- After win-x64 publish, automatically build linux-x64 via Docker -->
  <Target Name="PublishLinuxX64" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' AND '$([MSBuild]::IsOSPlatform(Windows))' == 'true'">
    <Message Text="Building linux-x64 via Docker..." Importance="High" />
    <Exec Command="powershell -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\build-linux.ps1&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)\.." />
  </Target>
</Project>
