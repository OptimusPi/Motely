<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>$(MotelyVersion)</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Motely.NodeAddon</RootNamespace>
    <AssemblyName>Motely.NodeAddon</AssemblyName>
    <Description>Node.js addon for Motely (node-api-dotnet AOT).</Description>
    <!-- Per https://microsoft.github.io/node-api-dotnet/scenarios/js-aot-module.html -->
    <PublishAot>true</PublishAot>
    <PublishNodeModule>true</PublishNodeModule>
    <PublishMultiPlatformNodeModule>true</PublishMultiPlatformNodeModule>
    <PublishDir>$(MSBuildThisFileDirectory)..\motely-node\bin</PublishDir>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- No libicu needed; smaller image, fewer deps, perf tip -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.JavaScript.NodeApi" />
    <PackageReference Include="Microsoft.JavaScript.NodeApi.Generator" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
    <ProjectReference Include="..\Motely.Orchestration\Motely.Orchestration.csproj" />
  </ItemGroup>
</Project>
