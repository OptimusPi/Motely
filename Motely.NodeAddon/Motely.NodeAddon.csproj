<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>$(MotelyVersion)</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Motely.NodeAddon</RootNamespace>
    <AssemblyName>Motely.NodeAddon</AssemblyName>
    <Description>Node.js addon for Motely (node-api-dotnet AOT).</Description>
    <!-- AOT + Node Module (official pattern) -->
    <PublishAot>true</PublishAot>
    <PublishNodeModule>true</PublishNodeModule>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.JavaScript.NodeApi" />
    <PackageReference Include="Microsoft.JavaScript.NodeApi.Generator" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>
</Project>
