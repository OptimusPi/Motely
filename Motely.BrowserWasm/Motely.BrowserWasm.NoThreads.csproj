<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- No-threads build for browsers without SharedArrayBuffer/COOP/COEP -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WasmBundlerFriendlyBootConfig>true</WasmBundlerFriendlyBootConfig>
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmEnableThreads>false</WasmEnableThreads>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <MotelyFrameworkSubdir>_framework_nt</MotelyFrameworkSubdir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
    <ProjectReference Include="..\Motely.Orchestration\Motely.Orchestration.csproj" />
    <ProjectReference Include="..\Motely.Repository\Motely.Repository.csproj" />
  </ItemGroup>

  <Target Name="PublishToNpmPackage" AfterTargets="Publish">
    <PropertyGroup>
      <MotelyFrameworkSubdir Condition="'$(MotelyFrameworkSubdir)' == ''">_framework</MotelyFrameworkSubdir>
      <_NpmFrameworkPath>$(MSBuildThisFileDirectory)..\Motely.npm\$(MotelyFrameworkSubdir)</_NpmFrameworkPath>
    </PropertyGroup>
    <ItemGroup>
      <_FrameworkFiles Include="$(PublishDir)wwwroot\_framework\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(_NpmFrameworkPath)" />
    <MakeDir Directories="$(_NpmFrameworkPath)" />
    <Copy SourceFiles="@(_FrameworkFiles)" DestinationFiles="@(_FrameworkFiles->'$(_NpmFrameworkPath)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
