<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Bundler-friendly: output consumed by JS bundlers (Vite etc), not run directly in browser -->
    <WasmBundlerFriendlyBootConfig>true</WasmBundlerFriendlyBootConfig>
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmEnableThreads>true</WasmEnableThreads>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <BlazorWebAssemblyJiterpreter>false</BlazorWebAssemblyJiterpreter>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <EmccInitialHeapSize>67108864</EmccInitialHeapSize>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
    <ProjectReference Include="..\Motely.Orchestration\Motely.Orchestration.csproj" />
  </ItemGroup>

  <!-- Copy _framework to Motely.npm after publish so npm package contains WASM -->
  <Target Name="PublishToNpmPackage" AfterTargets="Publish">
    <PropertyGroup>
      <_NpmFrameworkPath>$(MSBuildThisFileDirectory)..\Motely.npm\_framework</_NpmFrameworkPath>
    </PropertyGroup>
    <ItemGroup>
      <_FrameworkFiles Include="$(PublishDir)wwwroot\_framework\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(_NpmFrameworkPath)" />
    <MakeDir Directories="$(_NpmFrameworkPath)" />
    <Copy SourceFiles="@(_FrameworkFiles)" DestinationFiles="@(_FrameworkFiles->'$(_NpmFrameworkPath)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
