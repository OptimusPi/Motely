<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<OutputType>Exe</OutputType>
<TargetFramework>net10.0</TargetFramework>
<RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
<IsMotelyWasmCompatBuild Condition="'$(IsMotelyWasmCompatBuild)' == ''">false</IsMotelyWasmCompatBuild>
<BootsharpEmbedBinaries Condition="'$(IsMotelyWasmCompatBuild)' == 'true'">true</BootsharpEmbedBinaries>
<BootsharpEmbedBinaries Condition="'$(IsMotelyWasmCompatBuild)' != 'true'">false</BootsharpEmbedBinaries>
<Nullable>enable</Nullable>
<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
<ImplicitUsings>enable</ImplicitUsings>
<InvariantGlobalization>true</InvariantGlobalization>
<Version>$(MotelyVersion)</Version>
<RootNamespace>Motely.BrowserWasm</RootNamespace>
<BootsharpName Condition="'$(IsMotelyWasmCompatBuild)' == 'true'">motely-wasm-compat</BootsharpName>
<BootsharpName Condition="'$(IsMotelyWasmCompatBuild)' != 'true'">motely-wasm</BootsharpName>
<BootsharpPublishDirectory Condition="'$(IsMotelyWasmCompatBuild)' == 'true'">motely-wasm-compat</BootsharpPublishDirectory>
<BootsharpPublishDirectory Condition="'$(IsMotelyWasmCompatBuild)' != 'true'">motely-wasm</BootsharpPublishDirectory>
<BootsharpAggressiveTrimming>true</BootsharpAggressiveTrimming>
<BootsharpLLVM>true</BootsharpLLVM>
<BootsharpOptimize>speed</BootsharpOptimize>
<PublishTrimmed>true</PublishTrimmed>
<DotNetJsApi>true</DotNetJsApi>
<DebugType>none</DebugType>
<EmccFlags>$(EmccFlags) -O3</EmccFlags>
<UsingBrowserRuntimeWorkload>false</UsingBrowserRuntimeWorkload>
<RestoreAdditionalProjectSources>https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json;</RestoreAdditionalProjectSources>
</PropertyGroup>

<!-- Bake $(Version) into a const so GetVersion() avoids reflection (trimmed/NativeAOT-safe). -->
<Target Name="GenerateVersionConst" BeforeTargets="CoreCompile">
<PropertyGroup>
<_Ver>$(Version)</_Ver>
<_Ver Condition="'$(_Ver)' == ''">0.0.0-dev</_Ver>
</PropertyGroup>
<WriteLinesToFile
File="$(MSBuildProjectDirectory)\VersionInfo.g.cs"
Lines="namespace Motely.BrowserWasm { internal static class VersionInfo { public const string Version = &quot;$(_Ver)&quot;%3B } }"
Overwrite="true" />
</Target>

<!-- .NET 10's runtime JS emits /*! webpackIgnore: true */ (with !) which breaks Next.js/webpack
     when embedded in the Bootsharp bundle. Bootsharp's InternalPatcher already adds the correct
     /*webpackIgnore:true*/ (no !). Strip the .NET variant from index.mjs. Remove when fixed upstream. -->
<Target Name="PatchWebpackComments" AfterTargets="BootsharpPack" BeforeTargets="MotelyWasmNpmOverlay;MotelyWasmCompatOverlay">
<Exec Condition="Exists('$(BootsharpPublishDirectory)\index.mjs')"
      Command="node -e &quot;const fs=require('fs');fs.writeFileSync('index.mjs',fs.readFileSync('index.mjs','utf8').replace(/\/\*!\s*webpackIgnore:\s*true\s*\*\//g,''))&quot;"
      WorkingDirectory="$(BootsharpPublishDirectory)" />
</Target>

<!-- Overlay repo npm metadata and docs on top of Bootsharp's generated package. -->
<Target Name="MotelyWasmNpmOverlay" AfterTargets="BootsharpPack" Condition="'$(IsMotelyWasmCompatBuild)' != 'true'">
<ReadLinesFromFile File="$(MSBuildProjectDirectory)\..\Motely\package.json">
<Output TaskParameter="Lines" ItemName="_PackageJsonLines" />
</ReadLinesFromFile>
<WriteLinesToFile
File="$(BootsharpPublishDirectory)\package.json"
Lines="@(_PackageJsonLines->Replace('&quot;version&quot;: &quot;0.0.0&quot;', '&quot;version&quot;: &quot;$(Version)&quot;'))"
Overwrite="true" />
<Copy SourceFiles="$(MSBuildProjectDirectory)\..\jaml.schema.json"
DestinationFiles="$(BootsharpPublishDirectory)\jaml.schema.json"
SkipUnchangedFiles="false"
Condition="Exists('$(MSBuildProjectDirectory)\..\jaml.schema.json')" />
<Copy SourceFiles="$(MSBuildProjectDirectory)\README-WASM.md"
DestinationFiles="$(BootsharpPublishDirectory)\README.md"
SkipUnchangedFiles="false"
Condition="Exists('$(MSBuildProjectDirectory)\README-WASM.md')" />
<Copy SourceFiles="$(MSBuildProjectDirectory)\..\tools\jimbos-ante-markup-language.ico"
DestinationFiles="$(BootsharpPublishDirectory)\favicon.ico"
SkipUnchangedFiles="false"
Condition="Exists('$(MSBuildProjectDirectory)\..\tools\jimbos-ante-markup-language.ico')" />
<ItemGroup>
<_MonacoFiles Include="$(MSBuildProjectDirectory)\..\tools\jaml-language\monaco\dist\**\*" />
</ItemGroup>
<MakeDir Directories="$(BootsharpPublishDirectory)\monaco" Condition="'@(_MonacoFiles)' != ''" />
<Copy SourceFiles="@(_MonacoFiles)"
DestinationFiles="@(_MonacoFiles->'$(BootsharpPublishDirectory)\monaco\%(RecursiveDir)%(Filename)%(Extension)')"
SkipUnchangedFiles="true"
Condition="'@(_MonacoFiles)' != ''" />
</Target>

<!-- Overlay motely-wasm-compat metadata on top of Bootsharp's generated package. -->
<Target Name="MotelyWasmCompatOverlay" AfterTargets="BootsharpPack" Condition="'$(IsMotelyWasmCompatBuild)' == 'true'">
<ReadLinesFromFile File="$(MSBuildProjectDirectory)\..\Motely\package-wasm-compat.json">
<Output TaskParameter="Lines" ItemName="_CompatPackageJsonLines" />
</ReadLinesFromFile>
<WriteLinesToFile
File="$(BootsharpPublishDirectory)\package.json"
Lines="@(_CompatPackageJsonLines->Replace('&quot;version&quot;: &quot;0.0.0&quot;', '&quot;version&quot;: &quot;$(Version)&quot;'))"
Overwrite="true" />
</Target>

<!-- LLVM builds don't copy .d.ts to types/; fix that here. -->
<Target Name="MotelyWasmCopyTypes" AfterTargets="MotelyWasmNpmOverlay;MotelyWasmCompatOverlay">
<ItemGroup>
<_TypeFiles Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\browser-wasm\publish\*.d.ts" />
</ItemGroup>
<MakeDir Directories="$(BootsharpPublishDirectory)\types" />
<Copy SourceFiles="@(_TypeFiles)" DestinationFolder="$(BootsharpPublishDirectory)\types" SkipUnchangedFiles="true" />
</Target>

<!-- Build embedded motely-wasm-compat package in a second publish pass. -->
<Target Name="MotelyWasmCompatPackage" AfterTargets="MotelyWasmCopyTypes" Condition="'$(IsMotelyWasmCompatBuild)' != 'true'">
<Exec
  Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) /p:IsMotelyWasmCompatBuild=true"
  WorkingDirectory="$(MSBuildProjectDirectory)" />
</Target>

<ItemGroup>
<ProjectReference Include="..\Motely\Motely.csproj" />
<PackageReference Include="Bootsharp" />
<PackageReference Include="Bootsharp.Inject" />
<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
</ItemGroup>

<ItemGroup>
<PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" />
<PackageReference Condition="$([MSBuild]::IsOSPlatform('Windows'))" Include="runtime.win-x64.Microsoft.DotNet.ILCompiler.LLVM" />
<PackageReference Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Include="runtime.linux-x64.Microsoft.DotNet.ILCompiler.LLVM" />
<EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_LLVM_ROOT=$(EmscriptenUpstreamBinPath)" />
<EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_BINARYEN_ROOT=$(EmscriptenSdkToolsPath)" />
<EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_NODE_JS=$(EmscriptenNodeBinPath)node$(ExecutableExtensionName)" />
<EmscriptenEnvVars Include="EM_CACHE=$(EmscriptenCacheSdkCacheDir)" />
</ItemGroup>
</Project>
