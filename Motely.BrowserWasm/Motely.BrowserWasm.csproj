<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- Do NOT add Content Include="wwwroot\**" - SDK includes wwwroot automatically; duplicate causes NETSDK1022 -->
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <Version>$(MotelyVersion)</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <RunAOTCompilation>true</RunAOTCompilation>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- AOT & Naive Build -->
    <WasmBuildNative>true</WasmBuildNative>
    <WasmEnableThreads>true</WasmEnableThreads>
    <WasmEnableSIMD>true</WasmEnableSIMD>

    <!-- Trimming & Optimization -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>

    <!-- SIZE REDUCTION: Disable symbols, debug levels, and default compression -->
    <WasmIncludeFullSymbols>false</WasmIncludeFullSymbols>
    <WasmDebugLevel>0</WasmDebugLevel>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>

    <WasmEmitCompressedAssets>false</WasmEmitCompressedAssets>
    <BlazorEnableCompression>false</BlazorEnableCompression>

    <!-- Globalization: Search doesn't need ICU data (~2.5MB saved) -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorWebAssemblyPreserveCollationData>false</BlazorWebAssemblyPreserveCollationData>

    <!-- Skip wasm-opt as it crashes on this specific binary output -->
    <WasmRunWasmOpt>false</WasmRunWasmOpt>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference
      Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>
 </Project>
