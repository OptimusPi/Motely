<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <!-- Default: single-thread WASM (Bootsharp npm). Multi-thread: dotnet publish /p:MotelyWasmThreads=true (see README-WASM.md). -->
    <WasmEnableThreads Condition="'$(MotelyWasmThreads)' != 'true'">false</WasmEnableThreads>
    <WasmEnableThreads Condition="'$(MotelyWasmThreads)' == 'true'">true</WasmEnableThreads>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>$(MotelyVersion)</Version>
    <RootNamespace>Motely.BrowserWasm</RootNamespace>
    <!-- Bootsharp npm output directory (default motely-wasm; MT variant motely-wasm-mt) -->
    <BootsharpName Condition="'$(MotelyWasmThreads)' != 'true'">motely-wasm</BootsharpName>
    <BootsharpPublishDirectory Condition="'$(MotelyWasmThreads)' != 'true'">motely-wasm</BootsharpPublishDirectory>
    <BootsharpName Condition="'$(MotelyWasmThreads)' == 'true'">motely-wasm-mt</BootsharpName>
    <BootsharpPublishDirectory Condition="'$(MotelyWasmThreads)' == 'true'">motely-wasm-mt</BootsharpPublishDirectory>
    <BootsharpAggressiveTrimming>true</BootsharpAggressiveTrimming>
    <!-- Default package uses NativeAOT-LLVM; MT package uses browser runtime path for now. -->
    <BootsharpLLVM Condition="'$(MotelyWasmThreads)' != 'true'">true</BootsharpLLVM>
    <BootsharpLLVM Condition="'$(MotelyWasmThreads)' == 'true'">false</BootsharpLLVM>
    <BootsharpOptimize>speed</BootsharpOptimize>
    <PublishTrimmed>true</PublishTrimmed>
    <DotNetJsApi>true</DotNetJsApi>
    <DebugType>none</DebugType>
    <EmccFlags>$(EmccFlags) -O3</EmccFlags>
    <UsingBrowserRuntimeWorkload Condition="'$(MotelyWasmThreads)' != 'true'">false</UsingBrowserRuntimeWorkload>
    <UsingBrowserRuntimeWorkload Condition="'$(MotelyWasmThreads)' == 'true'">true</UsingBrowserRuntimeWorkload>
    <RestoreAdditionalProjectSources Condition="'$(MotelyWasmThreads)' != 'true'">https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json;</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- Bake $(Version) into a const so GetVersion() avoids reflection (trimmed/NativeAOT-safe). -->
  <Target Name="GenerateVersionConst" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_Ver>$(Version)</_Ver>
      <_Ver Condition="'$(_Ver)' == ''">0.0.0-dev</_Ver>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)VersionInfo.g.cs"
      Lines="namespace Motely.BrowserWasm { internal static class VersionInfo { public const string Version = &quot;$(_Ver)&quot;%3B } }"
      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)VersionInfo.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Bootsharp already produced the full npm package; copy repo npm metadata + JAML schema. -->
  <Target Name="MotelyWasmNpmOverlay" AfterTargets="BootsharpPack">
    <PropertyGroup>
      <_WasmPkgDir Condition="'$(MotelyWasmThreads)' == 'true'">$(MSBuildProjectDirectory)\motely-wasm-mt</_WasmPkgDir>
      <_WasmPkgDir Condition="'$(MotelyWasmThreads)' != 'true'">$(MSBuildProjectDirectory)\motely-wasm</_WasmPkgDir>
      <_MotelyPkgJson Condition="'$(MotelyWasmThreads)' == 'true'">$(MSBuildProjectDirectory)\..\Motely\motely-wasm-mt.package.json</_MotelyPkgJson>
      <_MotelyPkgJson Condition="'$(MotelyWasmThreads)' != 'true'">$(MSBuildProjectDirectory)\..\Motely\package.json</_MotelyPkgJson>
      <_JamlSchema>$(MSBuildProjectDirectory)\..\jaml.schema.json</_JamlSchema>
    </PropertyGroup>
    <Copy SourceFiles="$(_MotelyPkgJson)" DestinationFiles="$(_WasmPkgDir)\package.json" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(_JamlSchema)" DestinationFiles="$(_WasmPkgDir)\jaml.schema.json" SkipUnchangedFiles="false" Condition="Exists('$(_JamlSchema)')" />
  </Target>

  <!-- Bootsharp MT index.mjs side-loads *.wasm from bin/; the linker writes them under AppBundle/_framework only. -->
  <Target Name="MotelyWasmMtCopyWasmToBin" AfterTargets="MotelyWasmNpmOverlay" Condition="'$(MotelyWasmThreads)' == 'true'">
    <PropertyGroup>
      <_AppBundleFramework>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\browser-wasm\AppBundle\_framework</_AppBundleFramework>
      <_MtBinDir>$(MSBuildProjectDirectory)\motely-wasm-mt\bin</_MtBinDir>
    </PropertyGroup>
    <ItemGroup>
      <_MtWasmFiles Include="$(_AppBundleFramework)\*.wasm" />
    </ItemGroup>
    <Warning Condition="'@(_MtWasmFiles)' == ''" Text="motely-wasm-mt: no *.wasm under $(_AppBundleFramework); threaded npm bin will be incomplete." />
    <Copy SourceFiles="@(_MtWasmFiles)" DestinationFolder="$(_MtBinDir)" SkipUnchangedFiles="true" Condition="'@(_MtWasmFiles)' != ''" />
  </Target>

  <!-- LLVM (ST) builds don't copy .d.ts to the npm types/ dir; fix that here.
       MT (browser-runtime) builds: Bootsharp already copies correct types — skip to avoid clobbering. -->
  <Target Name="MotelyWasmCopyTypes" AfterTargets="MotelyWasmNpmOverlay"
          Condition="'$(MotelyWasmThreads)' != 'true'">
    <PropertyGroup>
      <_PublishDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\browser-wasm\publish</_PublishDir>
    </PropertyGroup>
    <ItemGroup>
      <_TypeFiles Include="$(_PublishDir)\*.d.ts" />
    </ItemGroup>
    <MakeDir Directories="$(_WasmPkgDir)\types" />
    <Copy SourceFiles="@(_TypeFiles)" DestinationFolder="$(_WasmPkgDir)\types" SkipUnchangedFiles="true" Condition="'@(_TypeFiles)' != ''" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
    <PackageReference Include="Bootsharp" />
    <PackageReference Include="Bootsharp.Inject" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <!-- LLVM compiler (single-thread package only) -->
  <ItemGroup Condition="'$(MotelyWasmThreads)' != 'true'">
    <PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" />
    <PackageReference Condition="$([MSBuild]::IsOSPlatform('Windows'))" Include="runtime.win-x64.Microsoft.DotNet.ILCompiler.LLVM" />
    <PackageReference Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Include="runtime.linux-x64.Microsoft.DotNet.ILCompiler.LLVM" />
    <EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_LLVM_ROOT=$(EmscriptenUpstreamBinPath)" />
    <EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_BINARYEN_ROOT=$(EmscriptenSdkToolsPath)" />
    <EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_NODE_JS=$(EmscriptenNodeBinPath)node$(ExecutableExtensionName)" />
    <EmscriptenEnvVars Include="EM_CACHE=$(EmscriptenCacheSdkCacheDir)" />
  </ItemGroup>
</Project>
