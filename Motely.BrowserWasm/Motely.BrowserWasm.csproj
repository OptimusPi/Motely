<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- Do NOT add Content Include="wwwroot\**" - SDK includes wwwroot automatically; duplicate causes NETSDK1022 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Standard boot: dotnet.js uses fetch() for .wasm/.dat files at runtime.
         No ES6 import statements for binary files = works natively in all browsers.
         WasmBundlerFriendlyBootConfig was removed because it generates ES6 imports
         that no browser can resolve, requiring a custom transform pipeline. -->
    <!-- AOT: native WASM at publish; SIMD + threads for search performance -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmEnableThreads>true</WasmEnableThreads>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <!-- Skip wasm-opt post-link pass; it crashes on this binary (MSB3073).
         AOT + trimming still apply; the .wasm is just slightly larger. -->
    <WasmRunWasmOpt>false</WasmRunWasmOpt>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
    <ProjectReference Include="..\Motely.Orchestration\Motely.Orchestration.csproj" />
    <ProjectReference Include="..\Motely.Repository\Motely.Repository.csproj" />
  </ItemGroup>

  <!-- Copy _framework to Motely.npm after publish so npm package contains WASM -->
  <Target Name="PublishToNpmPackage" AfterTargets="Publish">
    <PropertyGroup>
      <MotelyFrameworkSubdir Condition="'$(MotelyFrameworkSubdir)' == ''">_framework</MotelyFrameworkSubdir>
      <_NpmFrameworkPath>$(MSBuildThisFileDirectory)..\Motely.npm\$(MotelyFrameworkSubdir)</_NpmFrameworkPath>
    </PropertyGroup>
    <ItemGroup>
      <_FrameworkFiles Include="$(PublishDir)wwwroot\_framework\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(_NpmFrameworkPath)" />
    <MakeDir Directories="$(_NpmFrameworkPath)" />
    <Copy SourceFiles="@(_FrameworkFiles)" DestinationFiles="@(_FrameworkFiles->'$(_NpmFrameworkPath)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
