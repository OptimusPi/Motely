{
  "name": "motely-wasm",
  "version": "1.2.8",
  "description": "Run the classic Analyzer on a Balatro seed, and more all in your browser!",
  "type": "module",
  "main": "index.js",
  "browser": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.js",
      "types": "./index.d.ts"
    },
    "./vite-plugin": {
      "import": "./vite-plugin-motely-wasm.js",
      "types": "./vite-plugin-motely-wasm.d.ts"
    },
    "./next-plugin": {
      "import": "./next-plugin-motely-wasm.js",
      "types": "./next-plugin-motely-wasm.d.ts"
    },
    "./jaml.schema.json": "./jaml.schema.json"
  },
  "files": [
    "_framework/",
    "index.js",
    "index.d.ts",
    "README.md",
    "jaml.schema.json",
    "vite-plugin-motely-wasm.js",
    "vite-plugin-motely-wasm.d.ts",
    "next-plugin-motely-wasm.js",
    "next-plugin-motely-wasm.d.ts"
  ],
  "keywords": [
    "balatro",
    "seed",
    "wasm",
    "webassembly",
    "browser-only",
    "jaml",
    "filter",
    "finder",
    "Blueprint",
    "Brainstorm",
    "Perkeo",
    "search",
    "ALEEB"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptimusPi/MotelyJAML.git",
    "directory": "Motely.npm"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
