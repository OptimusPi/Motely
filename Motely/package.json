{
  "name": "motely-wasm",
  "version": "5.1.27",
  "description": "MotelyJAML — Balatro seed search engine. NativeAOT-LLVM compiled to browser WASM via Bootsharp.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/wasm/types/index.d.ts",
      "import": "./dist/wasm/index.mjs",
      "default": "./dist/wasm/index.mjs"
    },
    "./jaml-schema": {
      "types": "./dist/jaml-schema.d.ts",
      "import": "./dist/jaml-schema.mjs",
      "default": "./dist/jaml-schema.mjs"
    },
    "./jaml.schema.json": "./dist/jaml.schema.json"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "balatro",
    "seed",
    "wasm",
    "bootsharp",
    "nativeaot-llvm",
    "jaml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptimusPi/MotelyJAML.git",
    "directory": "motely"
  },
  "license": "MIT",
  "scripts": {
    "publish:wasm": "node build/build.mjs",
    "publish:wasm:dry-run": "node build/build.mjs --dry-run --skip-bump",
    "publish:wasm:next": "node build/build.mjs --tag-next",
    "build": "node build/build.mjs",
    "build:schema": "dotnet run --project ../Motely.CLI/Motely.CLI.csproj -- --write-jaml-schema"
  }
}
