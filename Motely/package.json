{
  "name": "motely",
  "version": "5.1.18",
  "description": "MotelyJAML — Balatro seed search, analysis, and JAML filtering. Native Node.js module + Browser WASM.",
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index.d.ts",
        "default": "./dist/node/index.cjs"
      },
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/wasm/index.mjs"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/node/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    },
    "./jaml-schema": {
      "types": "./dist/jaml-schema.d.ts",
      "import": "./dist/jaml-schema.mjs",
      "default": "./dist/jaml-schema.mjs"
    },
    "./jaml.schema.json": "./dist/jaml.schema.json",
    "./browser": {
      "types": "./dist/wasm/types/index.d.ts",
      "import": "./dist/wasm/index.mjs",
      "default": "./dist/wasm/index.mjs"
    }
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "balatro",
    "seed",
    "wasm",
    "node-api",
    "aot",
    "native",
    "jaml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptimusPi/MotelyJAML.git",
    "directory": "motely"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "build:schema": "dotnet run --project ../Motely.CLI/Motely.CLI.csproj -- --write-jaml-schema",
    "prepublishOnly": "npm run build"
  }
}
