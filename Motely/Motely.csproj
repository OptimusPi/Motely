<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Library: do not publish when solution is published (publish apps instead) -->
    <IsPublishable>false</IsPublishable>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateProgramFile>false</GenerateProgramFile>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Output type: Library when multi-targeting, Exe for standalone CLI -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <OutputType Condition="!$(TargetFrameworks.Contains(';')) AND '$(Configuration)' != 'BSO_LIBRARY'">Exe</OutputType>
  </PropertyGroup>

  <!-- Desktop AOT -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PublishAot>true</PublishAot>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TrimmerDefaultAction>link</TrimmerDefaultAction>
  </PropertyGroup>
  
  <!-- AOT Trimming Configuration -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <!-- Browser WASM AOT -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-browser'">
    <DefineConstants>$(DefineConstants);BROWSER</DefineConstants>
    <WasmSIMD>true</WasmSIMD>
    <RunAOTCompilation>true</RunAOTCompilation>
    <!-- Suppress CA1416 warnings - browser-specific APIs (Barrier, Thread) are only called in browser builds -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Packages (versions from Directory.Packages.props) -->
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" PrivateAssets="all" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <!-- Exclude desktop-only from browser. Same MotelySearch.cs (real implementation) for both desktop and browser. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browser'">
    <Compile Remove="TUI\**\*.cs" />
    <Compile Remove="API\**\*.cs" />
    <Compile Remove="Executors\**\*.cs" />
    <Compile Remove="Program.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="API\**\*.cs" />
    <Compile Remove="TUI\**\*.cs" />
  </ItemGroup>
</Project>
