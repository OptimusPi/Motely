<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPublishable>true</IsPublishable>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateProgramFile>false</GenerateProgramFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Version>$(MotelyVersion)</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- NativeAOT for linux-x64 .node addon -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <PublishNodeModule>true</PublishNodeModule>
    <PackNpmPackage>true</PackNpmPackage>
    <PackageOutputPath>$(MSBuildThisFileDirectory)pkg</PackageOutputPath>
  </PropertyGroup>

  <!-- Packages (versions from Directory.Packages.props) -->
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" PrivateAssets="all" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <!-- NodeApi: Node.js bindings (net10.0 only — excluded from browser builds to avoid napi_register_module_v1 conflict with WASM) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.JavaScript.NodeApi" />
    <PackageReference Include="Microsoft.JavaScript.NodeApi.Generator" PrivateAssets="all" />
  </ItemGroup>

  <!-- Exclude desktop-only code -->
  <ItemGroup>
    <Compile Remove="API\**\*.cs" />
    <Compile Remove="TUI\**\*.cs" />
    <Compile Remove="MotelySearchSync.Browser.cs" />
  </ItemGroup>
</Project>
