<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateProgramFile>false</GenerateProgramFile>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Output type: Library when multi-targeting, Exe for standalone CLI -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <OutputType Condition="!$(TargetFrameworks.Contains(';')) AND '$(Configuration)' != 'BSO_LIBRARY'">Exe</OutputType>
  </PropertyGroup>

  <!-- Desktop AOT -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PublishAot>true</PublishAot>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TrimmerDefaultAction>link</TrimmerDefaultAction>
  </PropertyGroup>
  
  <!-- AOT Trimming Configuration -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <!-- Browser WASM AOT -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-browser'">
    <DefineConstants>$(DefineConstants);BROWSER</DefineConstants>
    <WasmSIMD>true</WasmSIMD>
    <RunAOTCompilation>true</RunAOTCompilation>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <!-- Desktop-only packages -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="DuckDB.NET.Data.Full" />
    <PackageReference Include="Terminal.Gui" />
  </ItemGroup>

  <!-- Browser packages -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browser'">
    <PackageReference Include="DuckDB.NET.Data.Full" />
  </ItemGroup>

  <!-- Cross-platform packages -->
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="McMaster.Extensions.CommandLineUtils" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" PrivateAssets="all" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Include shared source files -->
  <ItemGroup>
    <Compile Include="..\Motely.DB\**\*.cs" Exclude="..\Motely.DB\obj\**;..\Motely.DB\bin\**" />
    <Compile Include="..\Motely.Analysis\**\*.cs" Exclude="..\Motely.Analysis\obj\**;..\Motely.Analysis\bin\**" />
  </ItemGroup>

  <!-- Exclude desktop-only files from browser -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browser'">
    <Compile Remove="TUI\**\*.cs" />
    <Compile Remove="API\**\*.cs" />
    <Compile Remove="Executors\**\*.cs" />
    <Compile Remove="Program.cs" />
    <Compile Remove="MotelySearch.cs" />
  </ItemGroup>

  <!-- Exclude browser stub and moved files from desktop -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="API\**\*.cs" />
    <Compile Remove="TUI\**\*.cs" />
    <Compile Remove="MotelySearch.Browser.cs" />
  </ItemGroup>
</Project>
