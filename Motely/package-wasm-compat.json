{
  "name": "motely-wasm-compat",
  "version": "0.0.0",
  "description": "Motely browser WASM (single index.mjs, embedded WASM) + types + jaml.schema.json.",
  "type": "module",
  "main": "./index.mjs",
  "types": "./types/index.d.ts",
  "browser": {
    "fs/promises": false
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./jaml.schema.json": "./jaml.schema.json"
  },
  "files": [
    "index.mjs",
    "jaml.schema.json",
    "README.md",
    "types/**/*.d.ts"
  ],
  "keywords": [
    "balatro",
    "seed",
    "wasm",
    "bootsharp",
    "nativeaot-llvm",
    "jaml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptimusPi/MotelyJAML.git",
    "directory": "Motely"
  },
  "license": "MIT"
}
