{
  "name": "motely-wasm-compat",
  "version": "0.0.0",
  "description": "MotelyJAML WASM — minimal install: single index.mjs (WASM base64-embedded by Bootsharp) + TypeScript types. For jaml.schema.json, Monaco, and full assets use the motely-wasm package.",
  "type": "module",
  "main": "./index.mjs",
  "types": "./types/index.d.ts",
  "browser": {
    "fs/promises": false
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "types/**/*.d.ts"
  ],
  "keywords": [
    "balatro",
    "seed",
    "wasm",
    "bootsharp",
    "nativeaot-llvm",
    "jaml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptimusPi/MotelyJAML.git",
    "directory": "Motely"
  },
  "license": "MIT",
  "scripts": {
    "build:schema": "dotnet run --project ../Motely.CLI/Motely.CLI.csproj -- --write-jaml-schema"
  }
}
