<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
    <ProjectReference Include="..\Motely.Orchestration\Motely.Orchestration.csproj" />
    <ProjectReference Include="..\Motely.DistributedWorker\Motely.DistributedWorker.csproj" />
  </ItemGroup>

  <Target Name="CopyWasmFramework" BeforeTargets="Build">
    <Exec Command="npm install --prefer-offline" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="node copy-wasm.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
