# Scope only — no ${env} auth here (pnpm warns if the var is unset on every command).
# Auth belongs in user npmrc or the shell:
#   export GITHUB_TOKEN=ghp_…   # read:packages
#   echo '//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}' >> ~/.npmrc
# Or a one-shot:
#   GITHUB_TOKEN=ghp_… pnpm install
@rewaffle:registry=https://npm.pkg.github.com
