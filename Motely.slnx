{
  "version": "0.1.0",
  "projects": [
    {
      "name": "Motely",
      "path": "Motely/Motely.csproj",
      "type": "class-library",
      "frameworks": ["net10.0", "net10.0-browser"]
    },
    {
      "name": "Motely.API", 
      "path": "Motely.API/Motely.API.csproj",
      "type": "class-library",
      "frameworks": ["net10.0"]
    },
    {
      "name": "Motely.TUI",
      "path": "Motely.TUI/Motely.TUI.csproj", 
      "type": "console",
      "frameworks": ["net10.0"]
    },
    {
      "name": "Motely.Tests",
      "path": "Motely.Tests/Motely.Tests.csproj",
      "type": "class-library", 
      "frameworks": ["net10.0"]
    }
  ],
  "configurations": {
    "Debug": {
      "build": {
        "projects": ["Motely", "Motely.API", "Motely.TUI", "Motely.Tests"]
      }
    },
    "Release": {
      "build": {
        "projects": ["Motely", "Motely.API", "Motely.TUI", "Motely.Tests"]
      }
    }
  }
}
