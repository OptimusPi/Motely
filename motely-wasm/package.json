{
  "name": "motely-wasm",
  "version": "3.20.0",
  "description": "Balatro seed search, analysis, and JAML filtering â€” all in the browser via WASM.",
  "type": "module",
  "main": "index.js",
  "browser": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./jaml-schema": {
      "types": "./jaml-schema.d.ts",
      "import": "./jaml-schema.js"
    },
    "./jaml.schema.json": "./jaml.schema.json"
  },
  "files": [
    "_framework/",
    "_framework_st/",
    "index.js",
    "index.d.ts",
    "jaml-schema.js",
    "jaml-schema.d.ts",
    "jaml.schema.json"
  ],
  "keywords": [
    "balatro",
    "seed",
    "wasm",
    "webassembly",
    "jaml",
    "filter",
    "search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptimusPi/MotelyJAML.git",
    "directory": "motely-wasm"
  },
  "license": "MIT",
  "scripts": {
    "generate:jaml-schema": "dotnet run --project ../Motely.CLI/Motely.CLI.csproj -- --write-jaml-schema",
    "build": "npm run generate:jaml-schema",
    "stage-framework": "node ../stage-packages.mjs browser"
  }
}
