# =============================================================================
#  index.jaml — the Cloud9 Daily Challenge   (the front door of JAML)
# =============================================================================
#  This is the template for a JAML-driven daily ritual: plug ONE file like this
#  into the app and it serves a daily seed built around a joker's synergy.
#
#  Wee Joker loved twos. Cloud9 loves nines: it pays +$1 for every 9 in your
#  full deck, every round — so we hunt Erratic decks stuffed with nines and a
#  Cloud9 to cash them in.
#
#  Grammar + every option: see jaml.schema.jaml (same folder).
# =============================================================================

id: cloud9-daily
name: Cloud9 Daily
author: pifreak
description: >-
  A daily seed where Cloud9 turns a nine-stuffed Erratic deck into a money
  printer. Wee Joker loves twos; Cloud9 loves nines.
deck: Erratic        # Erratic re-rolls every card's rank + suit per seed — nine-farms live here
stake: White

defaults:
  antes: [1, 2, 3, 4, 5, 6, 7, 8]
  score: 1

# ── must: the gate. The daily only counts if the synergy is actually reachable.
must:
  - joker: Cloud9            # the engine of the build...
    antes: [1, 2, 3, 4]      # ...reachable by ante 4
  - erraticRank: Nine        # ...sitting on a deck loaded with nines
    min: 8                   # at least 8 nines  ->  +$8/round floor
                             # [inferred] min = count of nines in the Erratic deck

# ── should: the ranking. More nines & a shinier Cloud9 = a better daily seed.
should:
  - erraticRank: Nine
    min: 12
    score: 60                # a truly stacked nine-deck
  - joker: Cloud9
    edition: Negative
    score: 100               # the dream: a Negative Cloud9 (free joker slot)
  - voucher: Grabber
    score: 10                # +1 hand size to actually play all those nines

# ── mustNot: the veto. If any of these hit, throw the seed out.
mustNot:
  - joker: Cloud9
    stickers: [Eternal]      # no Eternal Cloud9 — the daily should stay sellable/flexible
