{
  "name": "jaml-ui-seed-finder-mcp-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently \"vite build --watch --mode mcp\" \"tsx --watch server.ts\"",
    "dev:web": "vite",
    "build": "vite build --mode mcp",
    "build:web": "vite build --mode web",
    "preserve": "npm run build",
    "serve": "tsx server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jaml-codemirror": "workspace:*",
    "jaml-ui": "workspace:*",
    "motely-wasm": "^23.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.13"
  }
}
