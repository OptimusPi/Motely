{
  "name": "motely-wasm",
  "version": "1.0.2",
  "description": "Balatro seed analyzer and searcher for the browser - WASM with SIMD + multi-threading (front-end only)",
  "author": "OptimusPi",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/loader.js",
  "browser": "dist/loader.js",
  "types": "dist/loader.d.ts",
  "sideEffects": false,
  "bin": {
    "motely-wasm-prepare": "scripts/prepare-public.js"
  },
  "exports": {
    ".": {
      "types": "./dist/loader.d.ts",
      "browser": {
        "default": "./dist/loader.js",
        "types": "./dist/loader.d.ts"
      },
      "import": {
        "default": "./dist/loader.js",
        "types": "./dist/loader.d.ts"
      },
      "require": {
        "default": "./index.js",
        "types": "./index.d.ts"
      },
      "default": {
        "default": "./dist/loader.js",
        "types": "./dist/loader.d.ts"
      }
    }
  },
  "files": [
    "dist/",
    "docs/",
    "jaml.schema.json",
    "scripts/prepare-public.js",
    "index.js",
    "index.d.ts",
    "motely-wasm.d.ts"
  ],
  "scripts": {
    "build": "dotnet publish -c Release && node scripts/prepare-npm.js && npx tsc",
    "prepack": "node scripts/prepack.js",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/prepare-public.js",
    "dev": "node scripts/serve-with-headers.cjs 3333 dist"
  },
  "homepage": "https://github.com/OptimusPi/Motely#readme",
  "bugs": {
    "url": "https://github.com/OptimusPi/Motely/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OptimusPi/Motely.git"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "balatro",
    "JAML",
    "Jimbo",
    "Ante",
    "Markup",
    "Language",
    "wasm",
    "seed",
    "analyzer",
    "searcher"
  ],
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.32.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
