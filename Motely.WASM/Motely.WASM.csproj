<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <!-- WASM AOT Configuration -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmSIMD>true</WasmSIMD>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
    
    <!-- Enable multi-threading (requires COOP/COEP headers on hosting server) -->
    <WasmEnableThreads>true</WasmEnableThreads>
    
    <!-- Trimming for smaller WASM output -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    
    <!-- Enable JavaScript interop exports -->
    <WasmBuildNative>true</WasmBuildNative>
    
    <!-- WASM uses RunAOTCompilation, not Native AOT (PublishAot) -->
    <PublishAot>false</PublishAot>
    
    <!-- Package metadata -->
    <Version>1.0.0</Version>
    <PackageId>Motely.WASM</PackageId>
    <Description>Balatro seed analyzer and searcher - Browser WASM build with JavaScript interop (SIMD + multi-threaded)</Description>
    <Authors>Motely Contributors</Authors>
    
    <!-- Suppress warnings for browser-specific code -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    
    <!-- JavaScript entry point for WASM initialization -->
    <WasmMainJSPath>main.js</WasmMainJSPath>
    
    <!-- Generate boot.js configuration file -->
    <WasmGenerateAppBundle>true</WasmGenerateAppBundle>
    <!-- Do not launch WasmAppHost on dotnet run; use run.ps1 to serve AppBundle -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  
  <!-- WASM uses in-memory search only (LaunchWithContext(..., useInMemoryStorage: true)). DuckDB is NOT used;
       it is pulled in via Motely.Orchestration -> Motely.DB and adds trim warnings + bundle weight.
       TODO: Refactor so WASM build does not reference Motely.DB (e.g. Orchestration multi-target or browser-only orchestration). -->
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" PrivateAssets="all" />
  </ItemGroup>
  
  <!-- Extra files to deploy with WASM -->
  <ItemGroup>
    <WasmExtraFilesToDeploy Include="index.html" />
    <WasmExtraFilesToDeploy Include="serve.json" />
  </ItemGroup>
  
  <!-- Reference Motely projects instead of including source files -->
  <!-- IMPORTANT: Build this .csproj directly, NOT the solution file!
       Building from the solution will try to build CLI/TUI/etc which can't run in WASM. -->
  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
    <ProjectReference Include="..\Motely.Orchestration\Motely.Orchestration.csproj" />
  </ItemGroup>
  
</Project>
