<Project>
  <PropertyGroup>
    <!-- Solution-wide version - change this one place to update all projects -->
    <MotelyVersion>1.2.11</MotelyVersion>
    <Version>$(MotelyVersion)</Version>
    <AssemblyVersion>$(MotelyVersion)</AssemblyVersion>
    <FileVersion>$(MotelyVersion)</FileVersion>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Android SDK Settings -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net10.0-android'))">
    <AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>
    <AndroidSdkDirectory>$(LOCALAPPDATA)\Android\android-sdk</AndroidSdkDirectory>
  </PropertyGroup>
</Project>
