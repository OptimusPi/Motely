<Project>
  <PropertyGroup>
    <!-- Prevent stale Visual Studio fallback package folders from leaking into restore/build. -->
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>
  <!-- Sync npm package.json version from Directory.Packages.props before build/publish.
       Edit only <MotelyVersion> in Directory.Packages.props, then dotnet publish — sync runs in one go. -->
  <Target Name="SyncNpmVersionBeforeBuild" BeforeTargets="Build;Publish"
          Condition="'$(MSBuildProjectName)' == 'Motely.BrowserWasm' or '$(MSBuildProjectName)' == 'Motely.NodeAddon'">
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)sync-version.mjs&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" IgnoreExitCode="false" />
  </Target>
</Project>
