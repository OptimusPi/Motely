<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-browser;net10.0-android;net10.0-ios</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Performance optimizations for desktop -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Optimize>true</Optimize>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!-- DuckDB for all platforms that support it -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-browser'">
    <PackageReference Include="DuckDB.NET.Data.Full" />
  </ItemGroup>

  <!-- Cross-platform packages -->
  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <!-- Reference core Motely SIMD library -->
  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>

</Project>
