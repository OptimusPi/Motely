# --- .NET build artifacts ---
bin/
obj/
*.user
*.suo
*.userprefs
.vs/

# --- JetBrains Rider / ReSharper ---
.idea/
*.DotSettings.user
_ReSharper.*/

# --- VS Code per-user state (keep shared .vscode/*.json tracked) ---
.vscode/*.user.*

# --- NuGet ---
*.nupkg
packages/

# --- Test results & coverage ---
TestResults/
*.trx
coverage/
*.coverage
*.coveragexml

# --- Bootsharp / WASM publish output (regenerated by `dotnet publish` on Motely.Wasm) ---
/motely-wasm/

# --- Node ---
node_modules/
npm-debug.log*
yarn-error.log
pnpm-debug.log*

# --- Logs & temp ---
*.log
*.tmp
*.bak
*~

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini

# --- Local agent / IDE state ---
.claude/settings.local.json
.claude/local/

# --- Motely runtime outputs (uncomment if you don't want these tracked) ---
# /Seeds/
# /analysis.json
