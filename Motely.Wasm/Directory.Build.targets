<Project>
  <!--
    Open Bootsharp 0.9.0 inspect patch. Source: D:\bootsharp InspectionContext.
    Does not overwrite the nuget package. Last UsingTask wins over Bootsharp.targets.
  -->
  <PropertyGroup>
    <_LocalBsPublish>D:\bootsharp\src\cs\Bootsharp.Publish\bin\Release\net10.0\Bootsharp.Publish.dll</_LocalBsPublish>
    <BsPublishAssembly Condition="Exists('$(_LocalBsPublish)')">$(_LocalBsPublish)</BsPublishAssembly>
  </PropertyGroup>
  <UsingTask
    Condition="Exists('$(_LocalBsPublish)') And '$(MSBuildRuntimeType)' != 'Full'"
    TaskName="Bootsharp.Publish.GenerateCS"
    AssemblyFile="$(_LocalBsPublish)" />
  <UsingTask
    Condition="Exists('$(_LocalBsPublish)') And '$(MSBuildRuntimeType)' != 'Full'"
    TaskName="Bootsharp.Publish.GenerateJS"
    AssemblyFile="$(_LocalBsPublish)" />
</Project>
