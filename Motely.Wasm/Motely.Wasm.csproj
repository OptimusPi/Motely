<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <Version>$(MotelyVersion)</Version>
    <BootsharpName>motely-wasm</BootsharpName>
    <!-- Bootsharp overwrites <dir>/package.json every build; park the throwaway in obj/. -->
    <BootsharpPackageDirectory>$(MSBuildProjectDirectory)\obj</BootsharpPackageDirectory>
    <!-- test.mjs imports ./Motely.Wasm/dist/index.mjs (npm-publishable layout; matches the
         reference impl + package.json "main"/"files"). Bootsharp emits the single-file module here. -->
    <BootsharpPublishDirectory>$(MSBuildProjectDirectory)\dist</BootsharpPublishDirectory>
    <!-- Empty BinariesDirectory = embedded base64 single-file: boot() needs no served files. -->
  </PropertyGroup>

  <!-- Cloudflare Workers (and other embedders that block runtime WebAssembly.compile/instantiate
       from raw bytes) can't boot the default embedded build: Bootsharp's boot() would call
       WebAssembly.instantiate() on raw bytes internally. Publish with
       -p:MotelyWasmTarget=workers to get a build that fixes this instead: a real, standalone
       .wasm file that BootsharpStaticWasmImport has resources.g.mjs statically import, so a
       bundler (eg Wrangler) precompiles it into a WebAssembly.Module at deploy time. boot()
       itself then detects that precompiled Module and links it via a custom instantiateWasm
       (cheap linking, not code generation - allowed even where dynamic compilation is blocked).
       Consumers keep calling plain boot() with no arguments, exactly as with the embedded build. -->
  <PropertyGroup Condition="'$(MotelyWasmTarget)' == 'workers'">
    <BootsharpPublishDirectory>$(MSBuildProjectDirectory)\dist-workers</BootsharpPublishDirectory>
    <BootsharpBinariesDirectory>$(MSBuildProjectDirectory)\dist-workers\bin</BootsharpBinariesDirectory>
    <BootsharpStaticWasmImport>true</BootsharpStaticWasmImport>
  </PropertyGroup>

  <!-- Bootsharp.FileSystem is a sponsor-exclusive extension: it ships on a private feed,
       not nuget.org. Referencing it unconditionally makes this project unbuildable for
       everyone who is not a sponsor — including on a second machine of your own, which is
       how motely-wasm shipped a version nobody could install. So the local-folder feature
       is opt-in: build with -p:EnableFileSystem=true where the feed is configured, and
       MotelyFileSystem's exports come along. Build without it and the engine is complete;
       there is simply no folder picker. -->
  <PropertyGroup>
    <EnableFileSystem Condition="'$(EnableFileSystem)' == ''">false</EnableFileSystem>
    <DefineConstants Condition="'$(EnableFileSystem)' == 'true'">$(DefineConstants);BOOTSHARP_FILESYSTEM</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bootsharp" />
    <PackageReference Include="Bootsharp.Inject" />
    <PackageReference Include="Bootsharp.FileSystem" Condition="'$(EnableFileSystem)' == 'true'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>

  <!-- package.json is the published npm manifest; MotelyVersion (Directory.Packages.props)
       is the single source of truth. Stamp it on every build so the two can never drift.

       A node script does the stamping, not an MSBuild regex over the raw file. MSBuild
       normalizes backslashes to forward slashes inside property values, so reading the JSON
       as text and writing it back turned every `\"` in a script string into `/"` — valid on
       Windows, corrupt everywhere else, and silent either way because nothing re-read the
       file during the build. Parsing real JSON has no opinion about backslashes. -->
  <Target Name="SyncNpmPackageVersion" BeforeTargets="Build">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/scripts/stamp-npm-version.mjs&quot; $(MotelyVersion)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="low" />
  </Target>
</Project>
