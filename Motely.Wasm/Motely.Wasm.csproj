<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <BootsharpName>motely-wasm</BootsharpName>
    <!-- Match samples/react/backend/Backend.WASM exactly: only set Package + Binaries.
         Let BootsharpPublishDirectory default ($(BootsharpPackageDirectory)/bin/$(BootsharpName)). -->
    <BootsharpPackageDirectory>$(MSBuildProjectDirectory)\..\motely-wasm</BootsharpPackageDirectory>
    <BootsharpBinariesDirectory>$(MSBuildProjectDirectory)\..\motely-wasm\bin</BootsharpBinariesDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bootsharp" />
    <PackageReference Include="Bootsharp.Inject" />
    <PackageReference Include="Bootsharp.FileSystem" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>

  <Target Name="GenerateVersionConstant" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_VersionLines Include="// &lt;auto-generated/&gt;" />
      <_VersionLines Include="namespace Motely.Wasm%3B" />
      <_VersionLines Include="internal static class MotelyVersionConstant" />
      <_VersionLines Include="{" />
      <_VersionLines Include="    public const string Value = &quot;$(MotelyVersion)&quot;%3B" />
      <_VersionLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile
        File="$(IntermediateOutputPath)MotelyVersion.g.cs"
        Lines="@(_VersionLines)"
        Overwrite="true"
        WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)MotelyVersion.g.cs" />
    </ItemGroup>
  </Target>

  <!-- README into the npm root. No package.json patching, no node-boot, no schema (re-add when POCO is stable). -->
  <Target Name="FinalizeNpmPackage" AfterTargets="BootsharpPack">
    <Copy SourceFiles="README.md" DestinationFolder="$(MSBuildProjectDirectory)\..\motely-wasm" />
  </Target>
</Project>
