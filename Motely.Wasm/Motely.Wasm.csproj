<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <Version>$(MotelyVersion)</Version>
    <BootsharpName>motely-wasm</BootsharpName>
    <BootsharpPackageDirectory>$(MSBuildProjectDirectory)\..\motely-wasm</BootsharpPackageDirectory>
    <BootsharpPublishDirectory>$(MSBuildProjectDirectory)\..\motely-wasm\dist</BootsharpPublishDirectory>
    <BootsharpBinariesDirectory>$(MSBuildProjectDirectory)\..\motely-wasm\dist\bin</BootsharpBinariesDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bootsharp" />
    <PackageReference Include="Bootsharp.Inject" />
    <PackageReference Include="Bootsharp.FileSystem" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>

  <Target Name="FinalizeNpmPackage" AfterTargets="Publish">
    <PropertyGroup>
      <_NpmRoot>$(MSBuildProjectDirectory)\..\motely-wasm</_NpmRoot>
      <_PackageJson>{
  "name": "motely-wasm",
  "type": "module",
  "version": "$(MotelyVersion)",
  "description": "Balatro seed finder and per-seed analyzer, compiled to WebAssembly.",
  "author": "Nathanial P. Howard",
  "license": "MIT",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": { "types": "./dist/index.d.mts", "import": "./dist/index.mjs" },
    "./*": { "types": "./dist/generated/modules/*.g.d.mts", "import": "./dist/generated/modules/*.g.mjs" }
  },
  "browser": {
    "node:fs": false,
    "node:url": false,
    "node:path": false,
    "node:module": false,
    "node:crypto": false,
    "node:process": false
  }
}</_PackageJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(_NpmRoot)\package.json" Overwrite="true" Lines="$(_PackageJson)" />
    <Message Text="motely-wasm v$(MotelyVersion) assembled at $(_NpmRoot)" Importance="high" />
  </Target>

</Project>
