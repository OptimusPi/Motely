<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <BootsharpName>motely-wasm</BootsharpName>
    <!-- Three distinct Bootsharp output sinks. motely-wasm/ (sibling, gitignored) is the
         npm-publish root. Keeping the sinks in separate directories lets Bootsharp's
         %MODULE_DIR% resolve to a clean "dist", so the generated package.json exports
         read "./dist/index.mjs" instead of "././index.mjs". -->
    <BootsharpPackageDirectory>$(MSBuildProjectDirectory)\..\motely-wasm</BootsharpPackageDirectory>
    <BootsharpPublishDirectory>$(MSBuildProjectDirectory)\..\motely-wasm\dist</BootsharpPublishDirectory>
    <!-- dotnet.native.wasm is fetched by boot() from a URL root, not imported as a module.
         Consumers (and Bootsharp's own boot() docs) expect that root at "<package>/bin", so
         this stays a package-root sibling of dist/, not under it. RemoveDir'd every pack —
         disposable, so never point it at a hand-maintained directory. -->
    <BootsharpBinariesDirectory>$(MSBuildProjectDirectory)\..\motely-wasm\bin</BootsharpBinariesDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bootsharp" />
    <PackageReference Include="Bootsharp.Inject" />
    <PackageReference Include="Bootsharp.FileSystem" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>

  <!-- Bake MotelyVersion as a compile-time const so Version() doesn't depend on
       AssemblyInformationalVersionAttribute reflection (which NativeAOT trims away,
       and which Motely.csproj already disables via GenerateAssemblyInfo=false).
       The const is inlined into IL, so trimming can't touch it. -->
  <Target Name="GenerateVersionConstant" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_VersionLines Include="// &lt;auto-generated/&gt;" />
      <_VersionLines Include="namespace Motely.Wasm%3B" />
      <_VersionLines Include="internal static class MotelyVersionConstant" />
      <_VersionLines Include="{" />
      <_VersionLines Include="    public const string Value = &quot;$(MotelyVersion)&quot;%3B" />
      <_VersionLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile
        File="$(IntermediateOutputPath)MotelyVersion.g.cs"
        Lines="@(_VersionLines)"
        Overwrite="true"
        WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)MotelyVersion.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Bootsharp rewrites package.json from its PackageTemplate.json every pack (Overwrite=true)
       and the template carries no "version" — but motely-wasm is npm-published and needs one.
       Inject MotelyVersion (source of truth: <MotelyVersion> in Directory.Packages.props) right
       after Bootsharp writes the file, and copy the README into the npm root (Bootsharp doesn't). -->
  <Target Name="FinalizeNpmPackage" AfterTargets="BootsharpPack">
    <PropertyGroup>
      <_NpmRoot>$(MSBuildProjectDirectory)\..\motely-wasm</_NpmRoot>
      <_NpmPackageJson>$(_NpmRoot)\package.json</_NpmPackageJson>
      <_PkgWithVersion>$([System.IO.File]::ReadAllText('$(_NpmPackageJson)').Replace('&quot;name&quot;: &quot;$(BootsharpName)&quot;,', '&quot;name&quot;: &quot;$(BootsharpName)&quot;,%0D%0A    &quot;version&quot;: &quot;$(MotelyVersion)&quot;,'))</_PkgWithVersion>
    </PropertyGroup>
    <Error Condition="!$(_PkgWithVersion.Contains('&quot;version&quot;'))"
           Text="Failed to inject version into $(_NpmPackageJson) — Bootsharp's PackageTemplate.json 'name' line may have changed. Update FinalizeNpmPackage in Motely.Wasm.csproj." />
    <!-- Exports-shape guard: catch the known-broken historic shapes BEFORE the file is written.
         17.3.1 shipped './../motely-wasm/index.mjs' and 17.3.2 shipped '././index.mjs' — both
         made Node refuse `import`. The three-distinct-sinks setup above should produce
         './dist/index.mjs', but a Bootsharp template change or sink-directory collapse could
         regress it. CLAUDE.md publish procedure step 2 documents this as a manual eyeball;
         this turns it into a build failure instead. -->
    <Error Condition="!$(_PkgWithVersion.Contains('&quot;./dist/index.mjs&quot;'))"
           Text="motely-wasm package.json is missing the expected exports entry './dist/index.mjs'. Bootsharp's PackageTemplate.json may have changed its exports shape, or %MODULE_DIR% resolved unexpectedly. Inspect BootsharpPackageDirectory vs BootsharpPublishDirectory above — they must remain in distinct directories." />
    <Error Condition="$(_PkgWithVersion.Contains('&quot;././index.mjs&quot;'))"
           Text="motely-wasm package.json exports regressed to '././index.mjs' (17.3.2 bug class). BootsharpPackageDirectory and BootsharpPublishDirectory have collapsed to the same directory — keep them distinct so %MODULE_DIR% resolves to 'dist', not '.'." />
    <Error Condition="$(_PkgWithVersion.Contains('&quot;./../motely-wasm/index.mjs&quot;'))"
           Text="motely-wasm package.json exports regressed to './../motely-wasm/index.mjs' (17.3.1 bug class). BootsharpPublishDirectory is escaping the package root — it must be a subdirectory of BootsharpPackageDirectory (currently motely-wasm/dist)." />
    <WriteLinesToFile File="$(_NpmPackageJson)" Lines="$(_PkgWithVersion)" Overwrite="true" />
    <!-- No SkipUnchangedFiles: the destination is gitignored and may carry stale manual edits with newer
         mtimes than the source. SkipUnchangedFiles would then preserve the scribble through `dotnet publish`
         and ship it to npm. Always overwrite. -->
    <Copy SourceFiles="README.md" DestinationFolder="$(_NpmRoot)" />
    <Message Text="motely-wasm npm package finalized at $(_NpmRoot) (version $(MotelyVersion))" Importance="high" />
  </Target>
</Project>
