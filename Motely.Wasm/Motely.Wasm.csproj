<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>$(MotelyVersion)</Version>
    <!-- Single-threaded WASM: no SharedArrayBuffer, no COOP/COEP headers required on the host. -->
    <WasmEnableThreads>false</WasmEnableThreads>
    <!-- Bootsharp module name = npm package name. -->
    <BootsharpName>motely-wasm</BootsharpName>
    <!-- Publish the JS module + the (overwritten-each-build) package.json into a clean, gitignored
         sibling dir so `cd motely-wasm && npm publish` ships exactly that dir. -->
    <BootsharpPublishDirectory>$(MSBuildProjectDirectory)/../motely-wasm</BootsharpPublishDirectory>
    <BootsharpPackageDirectory>$(MSBuildProjectDirectory)/../motely-wasm</BootsharpPackageDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bootsharp" />
    <PackageReference Include="Bootsharp.Inject" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>

  <!-- Stamp the version Bootsharp didn't put on the package.json it just clobbered.
       `npm pkg set` is the npm-native way to mutate package.json; no JS scripts, no sync hooks. -->
  <Target Name="BootsharpStampVersion" AfterTargets="BootsharpPack">
    <Exec Command="npm pkg set version=$(MotelyVersion)"
          WorkingDirectory="$(BootsharpPackageDirectory)" />
  </Target>

</Project>
