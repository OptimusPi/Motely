<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <ImplicitUsings>enable</ImplicitUsings>
        <BootsharpName>motely-wasm</BootsharpName>
        <BootsharpPublishDirectory>$(MSBuildProjectDirectory)\..\motely-wasm</BootsharpPublishDirectory>
        <BootsharpTypesDirectory>$(MSBuildProjectDirectory)\..\motely-wasm\types</BootsharpTypesDirectory>
        <BootsharpPackageDirectory>$(MSBuildProjectDirectory)\..\motely-wasm</BootsharpPackageDirectory>
        <BootsharpEmbedBinaries>true</BootsharpEmbedBinaries>
        <BootsharpLlvm>true</BootsharpLlvm>
        <WasmEnableSIMD>true</WasmEnableSIMD>
        <EmccFlags>$(EmccFlags) -msimd128</EmccFlags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Bootsharp" />
        <PackageReference Include="Bootsharp.Inject" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Motely/Motely.csproj"/>
    </ItemGroup>

    <!--
      Bootsharp emits a minimal package.json from PackageTemplate.json (just name, type, main, types).
      We overwrite it with the full npm-ready manifest so description, homepage, repository,
      keywords, bugs, and license survive every publish.
    -->
    <Target Name="WriteFullPackageJson" AfterTargets="Publish">
        <PropertyGroup>
            <_PkgJson>$(BootsharpPackageDirectory)\package.json</_PkgJson>
            <_PkgContent>{
    "name": "motely-wasm",
    "version": "$(MotelyVersion)",
    "description": "Find Balatro seeds with plain-language JAML filters — Jimbo's Ante Markup Language. SIMD-vectorized seed search (Motely engine, C#). Curate runs, share filters, search millions of seeds. Browser + Node.",
    "type": "module",
    "main": "index.mjs",
    "types": "types/index.d.ts",
    "license": "MIT",
    "homepage": "https://github.com/OptimusPi/MotelyJAML#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/OptimusPi/MotelyJAML",
        "directory": "motely-wasm"
    },
    "bugs": {
        "url": "https://github.com/OptimusPi/MotelyJAML/issues"
    },
    "keywords": [
        "balatro",
        "seed",
        "seed-finder",
        "seed-curator",
        "jaml",
        "jummy",
        "filter",
        "simd",
        "wasm",
        "webassembly",
        "motely"
    ]
}</_PkgContent>
        </PropertyGroup>
        <WriteLinesToFile File="$(_PkgJson)" Lines="$(_PkgContent)" Overwrite="true"/>
        <Message Text="motely-wasm package.json rewritten at version $(MotelyVersion)" Importance="high"/>
    </Target>

</Project>
