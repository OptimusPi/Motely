<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AssemblyName>Motely.Wasm</AssemblyName>
    <RootNamespace>Motely.Wasm</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The JSExport source generator emits unsafe marshalling stubs (SYSLIB1075). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The JS host boots the runtime and pulls [JSExport]s; no Bootsharp, no sponsor feed,
         nothing outside the in-box System.Runtime.InteropServices.JavaScript interop. -->
    <WasmMainJSPath>host/main.mjs</WasmMainJSPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
    <!-- Same protocol-free language brain the stdio LSP server uses: diagnostics, hover and
         completion come from the engine's own grammar, never a hand-written JS copy. -->
    <ProjectReference Include="..\Motely.Lsp.Core\Motely.Lsp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <WasmExtraFilesToDeploy Include="host/index.html" />
  </ItemGroup>
</Project>
