<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <ImplicitUsings>enable</ImplicitUsings>
        <BootsharpName>motely-wasm</BootsharpName>
        <BootsharpPublishDirectory>$(MSBuildProjectDirectory)\..\motely-wasm</BootsharpPublishDirectory>
        <BootsharpTypesDirectory>$(MSBuildProjectDirectory)\..\motely-wasm\types</BootsharpTypesDirectory>
        <BootsharpPackageDirectory>$(MSBuildProjectDirectory)\..\motely-wasm</BootsharpPackageDirectory>
        <BootsharpEmbedBinaries>true</BootsharpEmbedBinaries>
        <BootsharpAggressiveTrimming>true</BootsharpAggressiveTrimming>
        <BootsharpOptimize>speed</BootsharpOptimize>
        <BootsharpLLVM>true</BootsharpLLVM>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Bootsharp" />
        <PackageReference Include="Bootsharp.Inject" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Motely/Motely.csproj"/>
    </ItemGroup>

    <!-- LLVM backend properties (from llvm.md docs) -->

    <PropertyGroup>
        <PublishTrimmed>true</PublishTrimmed>
        <DotNetJsApi>true</DotNetJsApi>
        <DebugType>none</DebugType>
        <WasmEnableSIMD>true</WasmEnableSIMD>
        <EmccFlags>$(EmccFlags) -O3 -msimd128</EmccFlags>
        <UsingBrowserRuntimeWorkload>false</UsingBrowserRuntimeWorkload>
        <RestoreAdditionalProjectSources>
            https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json;
        </RestoreAdditionalProjectSources>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" />
        <PackageReference Condition="'$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))' == 'true'"
            Include="runtime.win-x64.Microsoft.DotNet.ILCompiler.LLVM" />
        <PackageReference Condition="'$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))' == 'false'"
            Include="runtime.linux-x64.Microsoft.DotNet.ILCompiler.LLVM" />
        <EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_LLVM_ROOT=$(EmscriptenUpstreamBinPath)"/>
        <EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_BINARYEN_ROOT=$(EmscriptenSdkToolsPath)"/>
        <EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_NODE_JS=$(EmscriptenNodeBinPath)node$(ExecutableExtensionName)"/>
        <EmscriptenEnvVars Include="EM_CACHE=$(EmscriptenCacheSdkCacheDir)"/>
    </ItemGroup>

    <!--
      Bootsharp emits a minimal package.json from PackageTemplate.json (just name, type, main, types).
      We overwrite it with the full npm-ready manifest so description, homepage, repository,
      keywords, bugs, and license survive every publish.
    -->
    <Target Name="WriteFullPackageJson" AfterTargets="Publish">
        <PropertyGroup>
            <_PkgJson>$(BootsharpPackageDirectory)\package.json</_PkgJson>
            <_PkgContent>{
    "name": "motely-wasm",
    "version": "$(MotelyVersion)",
    "description": "Find Balatro seeds with plain-language JAML filters — Jimbo's Ante Markup Language. SIMD-vectorized seed search (Motely engine, C#). Curate runs, share filters, search millions of seeds. Browser + Node.",
    "type": "module",
    "main": "index.mjs",
    "types": "types/index.d.ts",
    "license": "MIT",
    "homepage": "https://github.com/OptimusPi/MotelyJAML#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/OptimusPi/MotelyJAML",
        "directory": "motely-wasm"
    },
    "bugs": {
        "url": "https://github.com/OptimusPi/MotelyJAML/issues"
    },
    "keywords": [
        "balatro",
        "seed",
        "seed-finder",
        "seed-curator",
        "jaml",
        "jummy",
        "filter",
        "simd",
        "wasm",
        "webassembly",
        "motely"
    ]
}</_PkgContent>
        </PropertyGroup>
        <WriteLinesToFile File="$(_PkgJson)" Lines="$(_PkgContent)" Overwrite="true"/>
        <Message Text="motely-wasm package.json rewritten at version $(MotelyVersion)" Importance="high"/>
    </Target>

</Project>
