<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <Version>$(MotelyVersion)</Version>
    <BootsharpName>motely-wasm</BootsharpName>
    <!--
      DO NOT point BootsharpPackageDirectory at ..\motely-wasm.
      Bootsharp OVERWRITES <dir>/package.json on EVERY build with its own bare
      template (no version, no types, no author) — see Bootsharp.targets, the
      "Publish package file" WriteLinesToFile step. Aiming it at the real npm
      root clobbers our hand-maintained motely-wasm/package.json every build,
      which then fails `npm publish` (no version -> "reading 'prerelease'").
      We park that throwaway template in obj/ (gitignored) and never use it.
      motely-wasm/package.json is hand-maintained and static. Edit it directly.
      DO NOT re-add a FinalizeNpmPackage MSBuild target to "fix" this.
    -->
    <BootsharpPackageDirectory>$(MSBuildProjectDirectory)\obj</BootsharpPackageDirectory>
    <BootsharpPublishDirectory>$(MSBuildProjectDirectory)\..\motely-wasm\dist</BootsharpPublishDirectory>
    <BootsharpBinariesDirectory>$(MSBuildProjectDirectory)\..\motely-wasm\dist\bin</BootsharpBinariesDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bootsharp" />
    <PackageReference Include="Bootsharp.Inject" />
    <PackageReference Include="Bootsharp.FileSystem" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>

</Project>
