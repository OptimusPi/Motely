<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <Version>$(MotelyVersion)</Version>
    <BootsharpName>motely-wasm</BootsharpName>
    <!--
      Bootsharp OVERWRITES <dir>/package.json on EVERY build with its own bare
      template — park the throwaway in obj/ (gitignored) so it never clobbers
      our hand-maintained package.json here in the project root.
    -->
    <BootsharpPackageDirectory>$(MSBuildProjectDirectory)\obj</BootsharpPackageDirectory>
    <!-- BinariesDirectory EMPTY = embedded base64 single-file (for the CDN <script> tag). -->
    <BootsharpPublishDirectory>$(MSBuildProjectDirectory)\dist</BootsharpPublishDirectory>
  </PropertyGroup>

  <!--
    === NativeAOT-LLVM is AUTOMATIC in Release — verified against installed Bootsharp source ===
    Bootsharp.props sets `BsLlvm = !$(BsDebug)` → TRUE for any `-c Release` build, and
    Bootsharp.targets then imports the ILCompiler.LLVM toolchain it BUNDLES at
    `$(BsLlvmDir) = $(BsRoot)/llvm` (confirmed present in the nuget package). Props also
    sets DotNetJsApi / EmccFlags -O3 / UsingBrowserRuntimeWorkload=false / PublishTrimmed /
    DebugType=none under $(BsLlvm) for us. So: NOTHING to add here.
    The earlier "PR #175 recipe" was WRONG — `BootsharpLLVM` is not a real property (the
    internal switch is `BsLlvm`), and pulling a second ILC from the dnceng-experimental
    feed COLLIDES with the bundled one. A Mono dist (the `addRunDependency` boot crash)
    means the failing build was Debug (BsLlvm false), NOT that LLVM needs hand-wiring.
    Build with `dotnet publish -c Release` and the LLVM path turns on by itself.
  -->
  <ItemGroup>
    <PackageReference Include="Bootsharp" />
    <PackageReference Include="Bootsharp.Inject" />
    <PackageReference Include="Bootsharp.FileSystem" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>

  <!--
    JAML language tooling is GENERATED from the engine on every WASM build:
    jaml-lang/generate.mjs reads Motely/Enums + JamlConfigLoader.Models.cs and
    emits jaml-lang/src/generated.ts + jaml-lsp/syntaxes/jaml.tmLanguage.json.
    The engine is the only source of truth — nobody hand-lists jokers again.
  -->
  <Target Name="GenerateJamlLang" AfterTargets="Build">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)\..\jaml-lang\generate.mjs&quot;" />
  </Target>

</Project>
