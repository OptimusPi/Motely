# Optional: only needed if you install the peer @rewaffle/bootsharp-file-system.
# Token from the environment — never a literal PAT in this file.
#   export NODE_AUTH_TOKEN=ghp_...   # GitHub PAT with read:packages
@rewaffle:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
