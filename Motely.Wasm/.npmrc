# GitHub Packages for @rewaffle/* (Bootsharp.FileSystem JS half).
# Token lives in the environment only — never paste a PAT into this file.
#   export RNV=ghp_...   # classic PAT with read:packages (or fine-grained: Packages read)
@rewaffle:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${RNV}
