{
  "name": "motely-wasm",
  "type": "module",
  "version": "24.4.0",
  "description": "Balatro seed search + per-seed analysis, powered by JAML (Jimbo's Ante Markup Language). Vectorized SIMD engine, compiled to WebAssembly.",
  "author": "Nathanial P. Howard",
  "license": "MIT",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "dotnet publish Motely.Wasm.csproj -c Release && node scripts/patch-dist-base64-polyfill.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "pretest": "npm run build",
    "test:ui": "playwright test",
    "serve": "node testui/serve.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@rewaffle/bootsharp-file-system": "*"
  },
  "peerDependenciesMeta": {
    "@rewaffle/bootsharp-file-system": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@rewaffle/bootsharp-file-system": "latest"
  }
}
