# yaml-language-server: $schema=../jaml.schema.json
name: Polychrome Perkeo / Judgement
deck: Magic
stake: White

blueprintFromJudgement: &blueprintFromJudgement
  joker: Blueprint
  antes: [1]
  sources:
    judgement: [0]

must:
  - legendaryJoker: Perkeo
    antes: [1]
    boosterPacks: [1]
    edition: Negative
  - tarotCard: Judgement
    antes: [1]
    shopItems: [0, 1]
  - *blueprintFromJudgement

should:
  - smallBlindTag: NegativeTag
  - joker: Brainstorm
    antes: [1]
    sources:
      judgement: [1]
    score: 100

  - legendaryJoker: Any
    edition: Polychrome
    antes: [1, 2, 3, 4, 5]
    judgement: [0, 1, 2, 3]
    score: 100
  - joker: Any
    edition: Polychrome
    antes: [1, 2, 3, 4, 5]
    score: 50
  - standardCard: Any
    edition: Polychrome
    antes: [2, 3, 4, 5, 6]
    score: 25
