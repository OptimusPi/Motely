name: Perkeo-Cola-Mid-Trigger
author: nate
description: >
  Ghost White nuts-early Perkeo–Cola press (cashout at A3). Must (cheap→expensive):
  A3 NegativeTag cashout, Ankh in ante 1–2 shop slots 0–3, Perkeo in ante 1–2 packs
  0–3, Diet Cola ante 1–3, second Perkeo somewhere in 4–10. Should: late Perkeo
  tally, early BP/BS, OopsAll6s shop windows (A3 slots 2–7 / A4 0–3 / A5 0–1).
deck: Ghost
stake: White

# Must cost law: tags first (vector bouncers), then shop Ankh, Soul Perkeo, Cola,
# then late Perkeo. Full-space / nsfw hunts pay this every seed — keep musts sparse.
# Fork of PerkeoColaEarly → Mid A6 → operator said A3 cuz nuts.
must:
  # ~1/24 · free-neg cashout gate (ante 3 — earlier than Early A4 / classic A8)
  - tag: NegativeTag
    antes: [3]

  # Early Ankh face — shop only, slots 0–3
  - spectralCard: Ankh
    antes: [1, 2]
    sources:
      shopItems: [0, 1, 2, 3]

  # Early Soul / pack Perkeo (pack 0 is fixed buffoon — still listed for author clarity)
  - legendaryJoker: Perkeo
    antes: [1, 2]
    sources:
      boosterPacks: [0, 1, 2, 3]

  # Banked for Ankh-copy / sell → Double Tag
  - joker: DietCola
    antes: [1, 2, 3]

  # Second Perkeo after the A3 cashout line
  - legendaryJoker: Perkeo
    antes: [4, 5, 6, 7, 8, 9, 10]

# Should only runs after must — rank toys, not search bouncers.
should:
  - legendaryJoker: Perkeo
    antes: [4, 5, 6, 7, 8, 9, 10]
    score: 1
    label: perkeo_late
  - joker: Blueprint
    antes: [1, 2, 3]
    score: 10
    label: bp
  - joker: Brainstorm
    antes: [1, 2, 3]
    score: 10
    label: bs
  - or:
      clauses:
        - joker: OopsAll6s
          antes: [3]
          sources:
            shopItems: [2, 3, 4, 5, 6, 7]
          score: 100
        - joker: OopsAll6s
          antes: [4]
          sources:
            shopItems: [0, 1, 2, 3]
          score: 100
        - joker: OopsAll6s
          antes: [5]
          sources:
            shopItems: [0, 1]
          score: 100
    label: oops_window

# A6 lake invalidated by A3 scoot — re-hunt.
seeds:
  - 14598431
  - 6HART838
  - 513DRAW1
  - UOXN8111
  - GF6IG111
  - AIAXIUVW
  - AJAQJQK7
