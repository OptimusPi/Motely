name: Diet Cola 60 Neg — A8 cashout
author: for pi — Ankh+Perkeo early, cola stack, Neg tag A8, Perkeo refill
description: >
  Ghost / White. Must: Neg SB A8, Ankh A1 shop, Diet Cola banked, Perkeo min:2.
  Score: BIG points for early Blueprint/Brainstorm (copy core online before the
  cola burn). Rest of score = cool jokers deep in the A8 free/neg shop AND post-A8
  endless (antes 9–14). Enablers only; 60 negs is the cola/tag economy after play.
deck: Ghost
stake: White

# Cheap bouncers first (tags), then shop Ankh, cola, expensive dual Soul last.
must:
  - smallBlindTag: NegativeTag
    antes: [8]

  - spectralCard: Ankh
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]

  - joker: DietCola
    antes: [1, 2, 3, 4, 5, 6, 7]

  - legendaryJoker: Perkeo
    antes: [1, 2, 3, 4, 5, 6, 7, 8]
    min: 2
    sources:
      boosterPacks: [0, 1, 2, 3, 4, 5]

should:
  # ── High points: early copy core (antes 1–3) ─────────────────────────
  - joker: Blueprint
    antes: [1, 2, 3]
    score: 120
    label: bp_early
  - joker: Brainstorm
    antes: [1, 2, 3]
    score: 120
    label: bs_early

  # Soft setup polish (small vs early BP/BS)
  - legendaryJoker: Perkeo
    antes: [1]
    score: 15
    label: perkeo_a1
    sources:
      boosterPacks: [0, 1, 2, 3]
  - legendaryJoker: Perkeo
    antes: [8]
