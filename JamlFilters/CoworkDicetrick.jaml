name: Cowork Dicetrick
author: pifreak
description: >
  Rank the OopsSome6s seeds. Gate is loose (Oops! All 6s anywhere antes 1-8,
  shop or pack) so every seed from the sheet passes; Showman in ante 2 is the
  big score, engine jokers to duplicate with it fill the rest.
deck: Red
stake: White
must:
  - joker: OopsAll6s
    antes: [1, 2, 3, 4, 5, 6, 7, 8]
    sources:
      shopItems: [0, 1, 2, 3, 4, 5]
      boosterPacks: [0, 1, 2, 3]
should:
  - joker: Showman
    antes: [2]
    sources:
      shopItems: [0, 1, 2, 3, 4, 5]
      boosterPacks: [0, 1, 2, 3]
    score: 100
  - joker: Showman
    antes: [1, 3]
    score: 40
  - joker: OopsAll6s
    antes: [1, 2, 3]
    score: 30
  - joker: Blueprint
    antes: [1, 2, 3, 4]
    score: 35
  - joker: Brainstorm
    antes: [1, 2, 3, 4]
    score: 35
  - joker: Cavendish
    antes: [1, 2, 3]
    score: 20
  - voucher: Overstock
    antes: [1, 2]
    score: 15

