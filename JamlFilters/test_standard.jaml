name: test_standard_format
author: pifreak
description: Test with standard YAML format
deck: Ghost
stake: Black
must:
  - type: Event
    value: LuckyMoney
    antes:
      - 1
    rolls: [0]
should:
  - type: Event
    value: LuckyMoney
    antes:
      - 1
    rolls: [0,1]
  - type: And
    clauses:
      - type: SmallBlindTag
        value: NegativeTag
        antes: [2]
        score: 100
      - type: Or
        clauses:
          - type: Joker
            value: OopsAll6s
            antes: [2]
            shopSlots: [2, 3]
            score: 100
