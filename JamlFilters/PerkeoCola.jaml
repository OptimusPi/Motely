name: Perkeo-Cola
author: nate
description: >
  Ghost White Perkeo–Cola press. Must (cheap→expensive): A4 Negative cashout tag,
  Ankh in ante-1 shop slots 0–1 only (no packs), Perkeo ante-1 Soul pack, Diet Cola
  somewhere in 2–7. Should: BP/BS pummel, slot-0 Ankh, early cola, A4 rare shop depth.
  Engine may reorder must by cost; authored order matches that intent.
deck: Ghost
stake: White

# Must cost law: tags first (vector bouncers), then tight shop Ankh, then Soul Perkeo,
# then Cola. Full-space / nsfw hunts pay this every seed — keep musts sparse.
must:
  # ~1/24 · free-neg cashout gate
  - smallBlindTag: NegativeTag
    antes: [4]

  # Soul lives in pack 1 (pack 0 is fixed buffoon)
  - legendaryJoker: Perkeo
    antes: [1,2]
    sources:
      boosterPacks: [0,1,2,3]

  # First shop face only — two slots, no pack Ankh
  - spectralCard: Ankh
    antes: [1,2]
    sources:
      shopItems: [0, 1,2,3]



  # Banked for Ankh-copy / sell → Double Tag (any one ante 2–7)
  - joker: DietCola
    antes: [2,3]

# Should only runs after must — rank toys, not search bouncers.
should:
  - joker: Blueprint
    antes: [1, 2, 3]
    score: 100
    label: bp
  - joker: Brainstorm
    antes: [1, 2, 3]
    score: 100
    label: bs
  - joker: OopsAll6s
    antes: [4]
    sources:
      shopItems: [2, 3, 4, 5, 6, 7, 4, 9, 10, 11, 12, 13, 14, 15]
    score: 100
  - joker: OopsAll6s
    antes: [5]
    sources:
      shopItems: [0,1,2,3,4,5,6]
    score: 100

