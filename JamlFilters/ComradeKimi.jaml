name: Kimi's Lucky 88
author: grok + pi
description: >
  MotelyJam gift for Comrade Kimi — 8 is lucky. Showman opens the stage in
  ante 1; Erratic deck packed with Eights; 8 Ball is the lovely gift (score
  loud on antes 1–8). WHSIMD energy. Keyword hunt: KIMI.
deck: Erratic
stake: White

must:
  # the show, ante 1 ;)
  - uncommonJoker: Showman
    antes: [1]

  # the gift — 8 Ball joker
  - joker: EightBall

  # lucky eights in the erratic deck
  - erraticRank: Eight
    min: 8

should:
  # 100 for 8 Ball anywhere in the 1–8 arc — Kimi will think it's soo lovely
  - joker: EightBall
    antes: [1, 2, 3, 4, 5, 6, 7, 8]
    score: 100
    max: 1

  # extra eight-vibes (soft)
  - erraticRank: Eight
    score: 8

  - uncommonJoker: Showman
    antes: [1]
    score: 8
    max: 1

seeds:
  - 111WKIMI
