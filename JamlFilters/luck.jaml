name: luck
author: pifreak
description: >
  Same-ante only: Negative Tag on small blind AND shop Oops! All 6s with Negative edition.
  One branch per ante (2–8); OR means "hits on at least one of those antes" with tag+joker aligned.
deck: Anaglyph
stake: Black
must:
  - legendaryJoker: Any
    edition: Negative
    antes: [1]
    sources:
      boosterPacks: [0,1,2,3,4,5]
    score: 1000
  - legendaryJoker: Perkeo
    edition: Negative
    antes: [1]
    sources:
      boosterPacks: [0,1,2,3,4,5]
    score: 1000
  - voucher: Hieroglyph
    antes: [1]
should:
  - joker: anyrare
    edition: Negative
    antes: [2,3,4,5,6,7,8]
    sources:
      boosterPacks: [0,1,2,3,4,5]
    score: 10
