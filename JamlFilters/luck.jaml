name: luck
author: pifreak
description: >
  Same-ante only: Negative Tag on small blind AND shop Oops! All 6s with Negative edition.
  One branch per ante (2–8); OR means "hits on at least one of those antes" with tag+joker aligned.
deck: Anaglyph
stake: Black
should:
  - joker: Showman
    antes: [1, 2, 3]
    score: 50
  - legendaryJoker: Perkeo
    antes: [1, 2, 3]
    score: 1
  - and:
      - smallBlindTag: NegativeTag
        antes: [4]
      - uncommonJoker: OopsAll6s
        
        antes: [4]
        sources:
          shopItems: [2,3,4,5,6]
  - and:
      - smallBlindTag: NegativeTag
        antes: [5]
      - uncommonJoker: OopsAll6s
        
        antes: [5]
        sources:
          shopItems: [2,3,4,5,6]
  - and:
      - smallBlindTag: NegativeTag
        antes: [6]
      - uncommonJoker: OopsAll6s
        
        antes: [6]
        sources:
          shopItems: [2,3,4,5,6]
  - and:
      - smallBlindTag: NegativeTag
        antes: [7]
      - uncommonJoker: OopsAll6s
        
        antes: [7]
        sources:
          shopItems: [2,3,4,5,6]
  - and:
      - smallBlindTag: NegativeTag
        antes: [8]
      - uncommonJoker: OopsAll6s
        
        antes: [8]
        sources:
          shopItems: [2,3,4,5,6]
