name: Kings Court — endless scaler
author: pifreak
description: >
  Baron + Mime by ante 4 is the gate (the thing that multiplies itself). Score is
  everything that makes the kings steel, red-sealed, copied and retriggered.
deck: Anaglyph
stake: White
must:
  - joker: Baron
    antes: [1, 2, 3, 4]
    sources:
      shopItems: [0, 1, 2, 3, 4, 5]
      boosterPacks: [0, 1, 2, 3]
  - joker: Mime
    antes: [1, 2, 3, 4]
    sources:
      shopItems: [0, 1, 2, 3, 4, 5]
      boosterPacks: [0, 1, 2, 3]
should:
  - spectralCard: Cryptid
    antes: [1, 2, 3, 4, 5, 6]
    score: 60
  - spectralCard: Talisman
    antes: [1, 2, 3, 4, 5, 6]
    score: 40
  - spectralCard: DejaVu
    antes: [1, 2, 3, 4, 5, 6]
    score: 50
  - tarotCard: TheChariot
    antes: [1, 2, 3, 4, 5, 6]
    score: 30
  - tarotCard: Death
    antes: [1, 2, 3, 4, 5, 6]
    score: 40
  - joker: Blueprint
    antes: [1, 2, 3, 4, 5, 6]
    score: 50
  - joker: Brainstorm
    antes: [1, 2, 3, 4, 5, 6]
    score: 50
  - joker: SockAndBuskin
    antes: [1, 2, 3, 4, 5, 6]
    score: 35
  - joker: Showman
    antes: [1, 2, 3, 4]
    score: 25
  - voucher: Overstock
    antes: [1, 2, 3]
    score: 15
  - tag: NegativeTag
    antes: [1, 2, 3, 4, 5, 6]
    score: 20
