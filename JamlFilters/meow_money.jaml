name: Meow Money
author: AI Cat
description: |
  🐱💰 MEOW MONEY 💰🐱
  Find seeds blessed by the Lucky Cat!
  Prioritizes early LuckyMoney hits - because the first $20 
  is worth more than the hundredth!

must:
  - or:
    - TarotCard: TheMagician
      Antes: [1]
    - StandardCard:
      Antes: [1]
      Enhancement: Lucky
  - event: LuckyMoney
    antes: [1]
    rolls: [0, 1]

should:
  - or:
    - TarotCard: TheMagician
      Antes: [1]
    - StandardCard:
      Antes: [1]
      Enhancement: Lucky
    score: 77

  # 🌟 LEGENDARY: First roll hits in Ante 1 = JACKPOT
  - event: LuckyMoney
    antes: [1]
    rolls: [0]
    score: 100

  # 💎 EPIC: Second roll in Ante 1
  - event: LuckyMoney
    antes: [1]
    rolls: [1]
    score: 50

  # 🔥 RARE: Early rolls 2-5 in Ante 1
  - event: LuckyMoney
    antes: [1]
    rolls: [2, 3, 4, 5]
    score: 20

  # ✨ GOOD: First couple rolls in Ante 2
  - event: LuckyMoney
    antes: [2]
    rolls: [0, 1]
    score: 30

  # 🎯 NICE: More Ante 2 hits
  - event: LuckyMoney
    antes: [2]
    rolls: [2, 3, 4, 5]
    score: 10

  # 💵 BONUS: Early game consistency (Antes 3-4)
  - event: LuckyMoney
    antes: [3, 4]
    rolls: [0, 1, 2, 3]
    score: 5

  # 🪙 EXTRA: Late game sprinkles (Antes 5-8)
  - event: LuckyMoney
    antes: [5, 6, 7, 8]
    rolls: [0, 1, 2, 3, 4, 5]
    score: 2
