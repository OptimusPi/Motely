name: Luchador Double Tag Build
author: Motely Genie
description: Luchador boss blind with double tag combo and voucher support for big blind one-shot.

must:
  - boss: The Luchador
    antes: [1]
  - tags: [Investment, Negative, Voucher, Economy]  # Double tags
    antes: [2, 3, 4, 5, 6, 7, 8]
  - voucher: Overstock
    antes: [3, 4, 5, 6, 7, 8]
  - voucher: Reroll Surplus
    antes: [4, 5, 6, 7, 8]
  - tag: Small Blind
    antes: [2]
    sources:
      shopSlots: [0, 1]
      edition: Negative  # Free + Negative from Small Blind tag

should:
  - boss: The Hook
    score: 3  # One-shot ability
  - boss: The Ox
    score: 3
  - boss: The Wheel
    score: 3
  - tag: Orbital
    score: -5  # Avoid Orbital tags