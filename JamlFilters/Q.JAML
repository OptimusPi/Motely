        sources:
          packSlots: [0,1]
          shopSlots: [0,1]
  - And:
    label: "Ante 4 HIT!"
    score: 100
    clauses:
      - smallBlindTags: [BossTag, CouponTag, D6Tag, DoubleTag, EconomyTag, GarbageTag, HandyTag, InvestmentTag, NegativeTag, PolychromeTag, VoucherTag]
