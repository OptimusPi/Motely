<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>../coverage.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Motely/Motely.csproj" />
    <ProjectReference Include="../Motely.DataLake/Motely.DataLake.csproj" />
    <ProjectReference Include="../Motely.Lsp.Core/Motely.Lsp.Core.csproj" />
    <ProjectReference Include="../Motely.Lsp/Motely.Lsp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Verify.Xunit" />
    <PackageReference Include="Verify.DiffPlex" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Motely.Enums" />
  </ItemGroup>

  <!-- TEMPORARY: the Jimmolate/RunState re-add is in progress and these two test files reference
       API that isn't wired yet (NewRunState, GetBossForAnteWithState, CreateSettings jimmolate:).
       Excluded so the rest of the suite compiles and runs. Delete this ItemGroup to restore them
       once MotelySingleSearchContext.RunState.cs is finished. -->
  <ItemGroup>
    <Compile Remove="JimmolateFilterTests.cs" />
    <Compile Remove="JimmolateScoringOrderTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="seeds/*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Golden JAML files travel to the test output so data-driven tests can load them by name. -->
    <None Update="GoldenJamlFiles/*.jaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
