name: TheStar Diamond Flush
author: jammy
description: TheStar tarot with Greedy Joker for Diamond suit conversion
deck: Red
stake: White
must:
  - tarot: TheStar
    antes:
      - 1
      - 2
      - 3
      - 4
should:
  - commonJoker: GreedyJoker
    score: 40
  - uncommonJoker: RoughGem
    score: 30
