{
  "information_for_contributors": [
    "Structure. Vocabulary is Motely.Lsp semantic tokens off JamlSchema.",
    "Runs where the LSP cannot: first paint, no server, embedded fences."
  ],
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JAML",
  "scopeName": "source.jaml",
  "patterns": [
    { "include": "#comment" },
    { "include": "#block-scalar" },
    { "include": "#sequence-item" },
    { "include": "#mapping-key" },
    { "include": "#value" }
  ],
  "repository": {
    "comment": {
      "comment": "'#' opens a comment only at the start of a token — JamlDocumentParser.StripComment.",
      "match": "(?:(?<=^)|(?<=\\s))(#.*)$",
      "captures": {
        "1": { "name": "comment.line.number-sign.jaml" }
      }
    },

    "block-scalar": {
      "comment": "'|' keeps newlines, '>' folds them. Chomping indicators are refused by the parser.",
      "begin": "^(\\s*)([A-Za-z_][\\w-]*)\\s*(:)\\s*(?:([|>][-+])|([|>]))\\s*$",
      "beginCaptures": {
        "2": { "name": "entity.name.tag.jaml" },
        "3": { "name": "punctuation.separator.key-value.jaml" },
        "4": { "name": "invalid.illegal.block-style.jaml" },
        "5": { "name": "keyword.control.block-scalar.jaml" }
      },
      "end": "^(?=\\s*\\S)(?!\\1\\s)",
      "contentName": "string.unquoted.block.jaml",
      "patterns": []
    },

    "sequence-item": {
      "comment": "'- ' opens a clause; what follows re-enters the top level, so the line form and the keyed form both work.",
      "match": "^\\s*(-)(?=\\s|$)",
      "captures": {
        "1": { "name": "punctuation.definition.block.sequence.item.jaml" }
      }
    },

    "mapping-key": {
      "comment": "Which kind of key it is — root, discriminator, property — is the LSP's call.",
      "match": "(?:^|(?<=-\\s))\\s*([A-Za-z_][\\w-]*)\\s*(:)(?=\\s|$)",
      "captures": {
        "1": { "name": "entity.name.tag.jaml" },
        "2": { "name": "punctuation.separator.key-value.jaml" }
      }
    },

    "value": {
      "patterns": [
        { "include": "#flow-collection" },
        { "include": "#quoted-string" },
        { "include": "#range" },
        { "include": "#number" }
      ]
    },

    "flow-collection": {
      "comment": "'[a, b, c]' is JAML's only bracket syntax. '{}' is an explicit empty mapping.",
      "patterns": [
        {
          "begin": "\\[",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.sequence.begin.jaml" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.sequence.end.jaml" }
          },
          "patterns": [
            { "include": "#comment" },
            { "include": "#quoted-string" },
            { "include": "#range" },
            { "include": "#number" },
            { "match": ",", "name": "punctuation.separator.sequence.jaml" }
          ]
        },
        {
          "match": "\\{\\}",
          "name": "constant.language.empty-mapping.jaml"
        }
      ]
    },

    "range": {
      "comment": "'1-8' in antes:/shopItems:. Before #number so the dash does not split it.",
      "match": "\\b(\\d+)(-)(\\d+)\\b",
      "captures": {
        "1": { "name": "constant.numeric.integer.jaml" },
        "2": { "name": "punctuation.separator.range.jaml" },
        "3": { "name": "constant.numeric.integer.jaml" }
      }
    },

    "number": {
      "match": "(?<![\\w-])-?\\d+(?:\\.\\d+)?(?![\\w-])",
      "name": "constant.numeric.jaml"
    },

    "quoted-string": {
      "comment": "A matching pair of quotes is stripped by ParseScalarOrFlow; there is no escaping grammar.",
      "patterns": [
        {
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.jaml" } },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.jaml" } },
          "name": "string.quoted.double.jaml"
        },
        {
          "begin": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.jaml" } },
          "end": "'",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.jaml" } },
          "name": "string.quoted.single.jaml"
        }
      ]
    }
  }
}
