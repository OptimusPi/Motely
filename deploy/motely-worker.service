[Unit]
Description=Motely Distributed Seed Search Worker
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/motely-worker
ExecStart=/opt/motely-worker/MotelyWorker --pool https://www.seedfinder.app --threads 32
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment (optional - for local testing)
# Environment=DOTNET_EnableHWIntrinsic=1
# Environment=DOTNET_EnableAVX2=1

[Install]
WantedBy=multi-user.target
