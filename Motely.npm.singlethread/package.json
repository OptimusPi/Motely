{
  "name": "motely-wasm-singlethread",
  "version": "3.0.5",
  "description": "Run Motely in the browser with a dedicated single-threaded .NET WASM runtime.",
  "type": "module",
  "main": "index.js",
  "browser": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.js"
    },
    "./jaml-schema": {
      "types": "./jaml-schema.d.ts",
      "import": "./jaml-schema.js",
      "require": "./jaml-schema.js"
    },
    "./jaml.schema.json": "./jaml.schema.json"
  },
  "files": [
    "_framework/",
    "index.js",
    "index.d.ts",
    "jaml-schema.js",
    "jaml-schema.d.ts",
    "README.md",
    "jaml.schema.json"
  ],
  "keywords": [
    "balatro",
    "seed",
    "wasm",
    "webassembly",
    "browser-only",
    "single-thread",
    "jaml",
    "search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptimusPi/MotelyJAML.git",
    "directory": "Motely.npm.singlethread"
  },
  "license": "MIT",
  "scripts": {
    "generate:jaml-schema": "dotnet run --project ../Motely.CLI/Motely.CLI.csproj -- --write-jaml-schema",
    "build": "npm run generate:jaml-schema",
    "stage-framework": "node ../stage-packages.mjs singlethread",
    "prepack": "npm run build && npm run stage-framework",
    "prepublishOnly": "npm run prepack"
  }
}