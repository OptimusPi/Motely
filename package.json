{
  "name": "jaml-ui",
  "version": "3.0.1",
  "description": "Zero-dependency json-render engine + Balatro card sprites for MCP Apps.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./motely": {
      "types": "./dist/motely.d.ts",
      "default": "./dist/motely.js"
    },
    "./jimbo.css": "./dist/ui/jimbo.css",
    "./fonts.css": "./fonts.css",
    "./assets/*": "./assets/*"
  },
  "sideEffects": [
    "./fonts.css",
    "./dist/ui/jimbo.css",
    "./dist/index.js"
  ],
  "files": [
    "dist",
    "assets/*.png",
    "assets/fonts",
    "fonts.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit --pretty false",
    "prepack": "npm run build",
    "storybook": "storybook dev -p 3141",
    "build-storybook": "storybook build",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OptimusPi/jaml-ui"
  },
  "homepage": "https://github.com/OptimusPi/jaml-ui#readme",
  "bugs": {
    "url": "https://github.com/OptimusPi/jaml-ui/issues"
  },
  "keywords": [
    "balatro",
    "jaml",
    "motely",
    "seed",
    "card",
    "sprite",
    "ui",
    "json-render",
    "mcp"
  ],
  "author": "pifreak",
  "license": "MIT",
  "peerDependencies": {
    "motely-wasm": "^23.3.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "motely-wasm": "^23.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.0.3",
    "eslint-plugin-storybook": "10.4.6",
    "@storybook/addon-docs": "^10.4.6"
  }
}
