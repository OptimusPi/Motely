{
  "name": "jaml-lang",
  "version": "3.14.1",
  "description": "JAML (Jimbo's Ante Markup Language) language service — diagnostics, completions, hover, symbols. Vocab and key tables are GENERATED from the Motely engine on every Motely.Wasm build.",
  "type": "module",
  "license": "MIT",
  "author": "pifreak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptimusPi/MotelyJAML.git",
    "directory": "jaml-lang"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "node generate.mjs",
    "build": "npm run gen && tsc -p tsconfig.json",
    "check": "npm run gen && tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
