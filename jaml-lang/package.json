{
  "name": "@motely/jaml-lang",
  "version": "0.0.0",
  "description": "The JAML authoring contract: typed POCO + Zod schema + completion vocab, generated from the Motely C# enums.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./service": "./src/service.ts",
    "./vocab": "./src/vocab.generated.ts"
  },
  "scripts": {
    "gen": "node codegen/gen-vocab.mjs",
    "smoke": "tsx smoke.ts",
    "check": "npm run gen && tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
