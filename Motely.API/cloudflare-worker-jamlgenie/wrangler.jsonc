{
	"name": "jamlgenie",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-07",
	"compatibility_flags": ["nodejs_compat"],
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "jaml-examples"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}

