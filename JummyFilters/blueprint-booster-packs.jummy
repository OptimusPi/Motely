# Jummy v1 — human WHAT / WHERE; compiles 1:1 to JAML (Motely: JummyCompiler.TryCompile).
# WHAT = what to find (joker, tag, …). WHERE = antes + which shop / booster slots to check.

jummy: 1

name: Blueprint in booster packs
description: >
  Blueprint in ante 1 or 2 in the first and second booster packs.

deck: Red
stake: White

must:
  - what:
      rareJoker: Blueprint
    where:
      ante: "1 or 2"
      booster packs: "first and second"
