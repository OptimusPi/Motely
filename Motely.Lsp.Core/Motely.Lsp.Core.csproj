<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Protocol-free language brains: diagnostics, hover, completion — computed straight off
         the engine's own grammar (JamlSchema, JamlConfigLoader, JamlLine). The stdio shell
         (Motely.Lsp) and the browser (Motely.Wasm) both call in here, so the grammar stays
         authored exactly once, in C#. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>

</Project>
