<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The protocol-free language brain: diagnostics, hover, and completion computed
         straight off the engine's own grammar (JamlSchema, JamlConfigLoader, the engine's
         enums). The stdio shell (Motely.Lsp) and the browser (Motely.Wasm) both call in
         here, so the grammar stays authored exactly once, in C#. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>

</Project>
