# Normalize all text files to LF in the index. Working tree keeps OS-native line
# endings unless explicitly pinned below. This stops `core.autocrlf` from
# rewriting lockfiles / generated JSON / schemas on Windows checkouts.
* text=auto eol=lf

# Pin formats where tooling is picky about LF.
*.json        text eol=lf
*.jsonc       text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.jaml        text eol=lf
*.md          text eol=lf
*.js          text eol=lf
*.mjs         text eol=lf
*.cjs         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.cs          text eol=lf
*.csproj      text eol=lf
*.props       text eol=lf
*.targets     text eol=lf
*.sln         text eol=crlf
package-lock.json  text eol=lf
pnpm-lock.yaml     text eol=lf

# Binary — never normalize.
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.pdf         binary
*.zip         binary
*.tgz         binary
*.vsix        binary
*.nupkg       binary
*.dll         binary
*.exe         binary
*.wasm        binary
*.parquet     binary
*.ducklake    binary
*.db          binary

# Windows-only files keep CRLF.
*.ps1         text eol=crlf
*.cmd         text eol=crlf
*.bat         text eol=crlf
