{
  "name": "seedfinder-mcp-app",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP App: JAML filter editor + real Balatro seed search with motely-wasm",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "vite build",
    "dev": "cross-env NODE_ENV=development concurrently 'cross-env INPUT=mcp-app.html vite build --watch' 'tsx --watch main.ts'",
    "serve": "npm run build && node dist/main.mjs",
    "test": "echo 'no tests yet'"
  },
  "keywords": [
    "mcp",
    "balatro",
    "jaml",
    "seed-finder"
  ],
  "author": "pifreak",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "motely-wasm": "^24.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.15.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3"
  }
}
