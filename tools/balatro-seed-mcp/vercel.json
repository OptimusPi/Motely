{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/mcp", "destination": "/api/server" }
  ],
  "functions": {
    "api/server.ts": {
      "maxDuration": 300,
      "includeFiles": "mcp-ui/dist/**"
    },
    "api/search.ts": {
      "maxDuration": 300
    },
    "api/analyze.ts": {
      "maxDuration": 30
    }
  }
}