{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JAML Filter",
  "description": "Jimbo's Ante Markup Language — filter format for Balatro seed searches via MotelyJAML.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "deck": {
      "type": "string",
      "enum": ["Red", "Blue", "Yellow", "Green", "Black", "Magic", "Nebula", "Ghost", "Abandoned", "Checkered", "Zodiac", "Painted", "Anaglyph", "Plasma", "Erratic"],
      "default": "Red",
      "description": "Which deck to search with."
    },
    "stake": {
      "type": "string",
      "enum": ["White", "Red", "Green", "Black", "Blue", "Purple", "Orange", "Gold"],
      "default": "White",
      "description": "Which stake to search with."
    },
    "must": {
      "$ref": "#/$defs/clauseList",
      "description": "ALL clauses must match for a seed to be included."
    },
    "should": {
      "$ref": "#/$defs/clauseList",
      "description": "Scored clauses — each match adds to the seed's score. Not required to match."
    },
    "mustNot": {
      "$ref": "#/$defs/clauseList",
      "description": "Reject the seed if ANY of these clauses match."
    }
  },
  "$defs": {
    "clauseList": {
      "type": "array",
      "items": { "$ref": "#/$defs/clause" }
    },
    "clause": {
      "type": "object",
      "description": "A filter clause. Provide exactly ONE clause-type key (joker, voucher, boss, tag, etc.) plus optional modifiers.",
      "properties": {
        "joker": {
          "type": "string",
          "description": "Any joker by display name (e.g. \"Blueprint\", \"Perkeo\", \"Hack\")."
        },
        "commonJoker": {
          "type": "string",
          "description": "A common-rarity joker."
        },
        "uncommonJoker": {
          "type": "string",
          "description": "An uncommon-rarity joker."
        },
        "rareJoker": {
          "type": "string",
          "description": "A rare-rarity joker."
        },
        "legendaryJoker": {
          "type": "string",
          "description": "A legendary joker (Canio, Triboulet, Yorick, Chicot, Perkeo)."
        },
        "soulJoker": {
          "type": "string",
          "description": "A legendary joker obtained via The Soul spectral card."
        },
        "voucher": {
          "type": "string",
          "description": "Voucher name (e.g. \"Telescope\", \"Observatory\", \"Blank\")."
        },
        "boss": {
          "type": "string",
          "description": "Boss blind name (e.g. \"The Eye\", \"The Hook\", \"Amber Acorn\")."
        },
        "tag": {
          "type": "string",
          "description": "Tag name — matches either small or big blind tag."
        },
        "smallBlindTag": {
          "type": "string",
          "description": "Tag awarded for skipping the small blind."
        },
        "bigBlindTag": {
          "type": "string",
          "description": "Tag awarded for skipping the big blind."
        },
        "tarotCard": {
          "type": "string",
          "description": "Tarot card name (e.g. \"The Fool\", \"The Magician\")."
        },
        "spectralCard": {
          "type": "string",
          "description": "Spectral card name (e.g. \"The Soul\", \"Aura\", \"Wraith\")."
        },
        "planetCard": {
          "type": "string",
          "description": "Planet card name (e.g. \"Jupiter\", \"Saturn\")."
        },
        "standardCard": {
          "type": "string",
          "description": "Standard playing card (e.g. \"Ace of Spades\", \"10 of Hearts\")."
        },
        "erraticRank": {
          "type": "string",
          "description": "Rank filter for Erratic deck composition."
        },
        "erraticSuit": {
          "type": "string",
          "description": "Suit filter for Erratic deck composition."
        },
        "erraticCard": {
          "type": "string",
          "description": "Full card filter for Erratic deck composition."
        },
        "event": {
          "type": "string",
          "description": "Game event filter."
        },
        "antes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "description": "Which antes to check. 0 = pre-game. Example: [1] or [1, 2, 3]."
        },
        "edition": {
          "type": "string",
          "enum": ["Foil", "Holographic", "Polychrome", "Negative"],
          "description": "Required edition on the item."
        },
        "stickers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["Eternal", "Perishable", "Rental"]
          },
          "description": "Required sticker(s) on the item."
        },
        "seal": {
          "type": "string",
          "enum": ["Gold", "Red", "Blue", "Purple"],
          "description": "Required seal on a standard card."
        },
        "enhancement": {
          "type": "string",
          "enum": ["Bonus", "Mult", "Wild", "Glass", "Steel", "Stone", "Gold", "Lucky"],
          "description": "Required enhancement on a standard card."
        },
        "score": {
          "type": "number",
          "description": "Score value for 'should' clauses. Higher = more desirable."
        },
        "label": {
          "type": "string",
          "description": "Human-readable display name for this clause."
        },
        "sources": {
          "type": "object",
          "description": "Constrain WHERE in the ante this item must appear.",
          "properties": {
            "shopItems": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 },
              "description": "Shop queue slot indices (0-based)."
            },
            "shopJokers": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 },
              "description": "Shop joker slot indices."
            },
            "packs": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 },
              "description": "Booster pack indices."
            },
            "packItems": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 },
              "description": "Item indices within packs."
            },
            "deckDraw": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 },
              "description": "Starting hand draw positions."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "deck": "Red",
      "stake": "White",
      "must": [
        { "joker": "Blueprint", "antes": [1], "edition": "Negative" }
      ]
    },
    {
      "deck": "Red",
      "stake": "Gold",
      "must": [
        { "joker": "Blueprint", "antes": [1] },
        { "voucher": "Telescope", "antes": [1, 2] }
      ],
      "should": [
        { "joker": "Brainstorm", "antes": [1, 2, 3], "score": 10 }
      ],
      "mustNot": [
        { "boss": "The Eye" }
      ]
    }
  ]
}
