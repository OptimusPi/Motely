{
  "name": "@motely/jaml-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "jaml-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/app',{recursive:true});fs.copyFileSync('src/app/view.html','dist/app/view.html')\"",
    "build:app": "node build-app.mjs",
    "dev": "node --watch dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@motely/jaml-language-core": "workspace:*",
    "motely-wasm": "^7.0.4",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2"
  }
}
