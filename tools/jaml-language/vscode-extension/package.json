{
  "name": "jaml-language-support",
  "displayName": "Jimbo's Ante Markup Language",
  "description": "JAML and Jummy syntax highlighting, LSP diagnostics, completion, snippets, and YAML schema validation for filter files.",
  "version": "1.1.7",
  "publisher": "pifreak",
  "author": {
    "name": "pifreak"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OptimusPi/MotelyJAML.git",
    "directory": "tools/jaml-language/vscode-extension"
  },
  "license": "MIT",
  "icon": "icon.png",
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "homepage": "https://github.com/OptimusPi/MotelyJAML/tree/master/tools/jaml-language/vscode-extension",
  "bugs": {
    "url": "https://github.com/OptimusPi/MotelyJAML/issues"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jaml",
        "aliases": [
          "JAML",
          "jaml"
        ],
        "extensions": [
          ".jaml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jummy",
        "aliases": [
          "Jummy",
          "jummy"
        ],
        "extensions": [
          ".jummy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jaml",
        "scopeName": "source.jaml",
        "path": "./syntaxes/jaml.tmLanguage.json"
      },
      {
        "language": "jummy",
        "scopeName": "source.jaml",
        "path": "./syntaxes/jaml.tmLanguage.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "*.jaml",
          "*.jummy"
        ],
        "url": "./jaml.schema.json"
      }
    ],
    "snippets": [
      {
        "language": "jaml",
        "path": "./snippets/jaml.json"
      },
      {
        "language": "jummy",
        "path": "./snippets/jaml.json"
      }
    ]
  },
  "scripts": {
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../lsp-server/tsconfig.json",
    "compile": "npm run check-types && node esbuild.mjs",
    "build": "npm run compile",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run check-types && node esbuild.mjs --production",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.97.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2"
  }
}
