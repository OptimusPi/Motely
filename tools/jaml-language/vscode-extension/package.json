{
  "name": "jaml-language-support",
  "displayName": "Jimbo's Ante Markup Language",
  "description": "Curate Balatro seeded runs with JAML: syntax highlighting, live diagnostics, and notebook support powered by motely-wasm.",
  "version": "14.1.0",
  "publisher": "pifreak",
  "author": {
    "name": "pifreak"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OptimusPi/MotelyJAML.git",
    "directory": "tools/jaml-language/vscode-extension"
  },
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://github.com/OptimusPi/MotelyJAML/tree/master/tools/jaml-language/vscode-extension",
  "bugs": {
    "url": "https://github.com/OptimusPi/MotelyJAML/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Notebooks"
  ],
  "main": "./out/extension.js",
  "files": [
    "README.md",
    "icon.png",
    "language-configuration.json",
    "out/**",
    "schemas/**",
    "syntaxes/**"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jaml",
        "aliases": [
          "JAML",
          "jaml"
        ],
        "extensions": [
          ".jaml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jaml",
        "scopeName": "source.jaml",
        "path": "./syntaxes/jaml.tmLanguage.json"
      }
    ],
    "notebooks": [
      {
        "type": "jaml-notebook",
        "displayName": "JAML Seed Search Notebook",
        "selector": [
          {
            "filenamePattern": "*.jaml-notebook"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/node": "^22.0.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "motely-wasm": "^14.1.0"
  }
}