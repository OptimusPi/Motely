{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JAML",
  "scopeName": "source.jaml",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#top-level-key"
    },
    {
      "include": "#discriminator-key"
    },
    {
      "include": "#event-discriminator-key"
    },
    {
      "include": "#compound-key"
    },
    {
      "include": "#clause-property"
    },
    {
      "include": "#source-property"
    },
    {
      "include": "#joker-name"
    },
    {
      "include": "#voucher-name"
    },
    {
      "include": "#tarot-name"
    },
    {
      "include": "#spectral-name"
    },
    {
      "include": "#boss-name"
    },
    {
      "include": "#tag-name"
    },
    {
      "include": "#planet-name"
    },
    {
      "include": "#event-name"
    },
    {
      "include": "#card-shorthand"
    },
    {
      "include": "#edition"
    },
    {
      "include": "#sticker"
    },
    {
      "include": "#seal"
    },
    {
      "include": "#enhancement"
    },
    {
      "include": "#deck-stake"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#aesthetic"
    },
    {
      "include": "#string-quoted"
    },
    {
      "include": "#number"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.jaml"
    },
    "top-level-key": {
      "match": "^(id|name|author|dateCreated|description|deck|stake|defaults|must|should|mustNot|aesthetics|hashtags|seeds)\\s*:",
      "captures": {
        "1": {
          "name": "keyword.control.jaml"
        }
      }
    },
    "discriminator-key": {
      "match": "^\\s+(?:-\\s+)?(joker|jokers|commonJoker|commonJokers|uncommonJoker|uncommonJokers|rareJoker|rareJokers|legendaryJoker|soulJoker|voucher|vouchers|tarot|tarotCard|spectral|spectralCard|planet|planetCard|boss|tag|smallBlindTag|bigBlindTag|standardCard|erraticRank|erraticSuit|erraticCard|startingDraw|event)\\s*:",
      "captures": {
        "1": {
          "name": "entity.name.type.jaml"
        }
      }
    },
    "event-discriminator-key": {
      "match": "^\\s+(?:-\\s+)?(luckyMoney|luckyMult|misprintMult|wheelOfFortune|cavendishExtinct|grosMichelExtinct|spaceLevelup|businessPayout|bloodstoneTrigger|parkingPayout|glassDestroy|wheelStaysFlipped)\\s*:",
      "captures": {
        "1": {
          "name": "entity.name.type.event.jaml"
        }
      }
    },
    "compound-key": {
      "match": "^\\s+(?:-\\s+)?(and|or|clauses|mode)\\s*:",
      "captures": {
        "1": {
          "name": "keyword.operator.logic.jaml"
        }
      }
    },
    "clause-property": {
      "match": "^\\s+(antes|score|min|max|edition|enhancement|seal|stickers|rank|suit|rolls|soulEditionRolls|soulCardOnly|label|boosterPacks|shopItems|minShopSlot|maxShopSlot|minPackSlot|maxPackSlot|sources)\\s*:",
      "captures": {
        "1": {
          "name": "variable.parameter.jaml"
        }
      }
    },
    "source-property": {
      "match": "^\\s+(earlyAntesMaxPack|tags|requireMega|charmTag|etherealTag|judgement|rareTag|uncommonTag|wraith|soulCard|arcanaBoosterPacks|spectralBoosterPacks|riffRaff|purpleSealOrEightBall|emperor|sixthSense|seance|certificate|incantation|familiar|grim|deckDraw|uncommonShopJokers|rareShopJokers|commonShopJokers|allShopJokers)\\s*:",
      "captures": {
        "1": {
          "name": "variable.other.source.jaml"
        }
      }
    },
    "joker-name": {
      "match": "\\b(Joker|GreedyJoker|LustyJoker|WrathfulJoker|GluttonousJoker|JollyJoker|ZanyJoker|MadJoker|CrazyJoker|DrollJoker|SlyJoker|WilyJoker|CleverJoker|DeviousJoker|CraftyJoker|HalfJoker|CreditCard|Banner|MysticSummit|EightBall|Misprint|RaisedFist|ChaostheClown|ScaryFace|AbstractJoker|DelayedGratification|GrosMichel|EvenSteven|OddTodd|Scholar|BusinessCard|Supernova|RideTheBus|Egg|Runner|IceCream|Splash|BlueJoker|FacelessJoker|GreenJoker|Superposition|ToDoList|Cavendish|RedCard|SquareJoker|RiffRaff|Photograph|ReservedParking|MailInRebate|Hallucination|FortuneTeller|Juggler|Drunkard|GoldenJoker|Popcorn|WalkieTalkie|SmileyFace|GoldenTicket|Swashbuckler|HangingChad|ShootTheMoon|JokerStencil|FourFingers|Mime|CeremonialDagger|MarbleJoker|LoyaltyCard|Dusk|Fibonacci|SteelJoker|Hack|Pareidolia|SpaceJoker|Burglar|Blackboard|SixthSense|Constellation|Hiker|CardSharp|Madness|Seance|Vampire|Shortcut|Hologram|Cloud9|Rocket|MidasMask|Luchador|GiftCard|TurtleBean|Erosion|ToTheMoon|StoneJoker|LuckyCat|Bull|DietCola|TradingCard|FlashCard|SpareTrousers|Ramen|Seltzer|Castle|MrBones|Acrobat|SockAndBuskin|Troubadour|Certificate|SmearedJoker|Throwback|RoughGem|Bloodstone|Arrowhead|OnyxAgate|GlassJoker|Showman|FlowerPot|MerryAndy|OopsAll6s|TheIdol|SeeingDouble|Matador|Satellite|Cartomancer|Astronomer|Bootstraps|DNA|Vagabond|Baron|Obelisk|BaseballCard|AncientJoker|Campfire|Blueprint|WeeJoker|HitTheRoad|TheDuo|TheTrio|TheFamily|TheOrder|TheTribe|Stuntman|InvisibleJoker|Brainstorm|DriversLicense|BurntJoker|Canio|Triboulet|Yorick|Chicot|Perkeo)\\b",
      "name": "entity.name.function.joker.jaml"
    },
    "voucher-name": {
      "match": "\\b(Overstock|OverstockPlus|ClearanceSale|Liquidation|Hone|GlowUp|RerollSurplus|RerollGlut|CrystalBall|OmenGlobe|Telescope|Observatory|Grabber|NachoTong|Wasteful|Recyclomancy|TarotMerchant|TarotTycoon|PlanetMerchant|PlanetTycoon|SeedMoney|MoneyTree|Blank|Antimatter|MagicTrick|Illusion|Hieroglyph|Petroglyph|DirectorsCut|Retcon|PaintBrush|Palette)\\b",
      "name": "support.function.voucher.jaml"
    },
    "tarot-name": {
      "match": "\\b(TheFool|TheMagician|TheHighPriestess|TheEmpress|TheEmperor|TheHierophant|TheLovers|TheChariot|Justice|TheHermit|TheWheelOfFortune|Strength|TheHangedMan|Death|Temperance|TheDevil|TheTower|TheStar|TheMoon|TheSun|Judgement|TheWorld)\\b",
      "name": "support.class.tarot.jaml"
    },
    "spectral-name": {
      "match": "\\b(Familiar|Grim|Incantation|Talisman|Aura|Wraith|Sigil|Ouija|Ectoplasm|Immolate|Ankh|DejaVu|Hex|Trance|Medium|Cryptid|TheSoul|BlackHole)\\b",
      "name": "support.class.spectral.jaml"
    },
    "boss-name": {
      "match": "\\b(TheClub|TheGoad|TheHead|TheHook|TheManacle|ThePillar|ThePsychic|TheWindow|TheArm|TheFish|TheFlint|TheHouse|TheMark|TheMouth|TheNeedle|TheWall|TheWater|TheWheel|TheEye|TheTooth|ThePlant|TheSerpent|TheOx|AmberAcorn|CeruleanBell|CrimsonHeart|VerdantLeaf|VioletVessel)\\b",
      "name": "support.type.boss.jaml"
    },
    "tag-name": {
      "match": "\\b(UncommonTag|RareTag|NegativeTag|FoilTag|HolographicTag|PolychromeTag|InvestmentTag|VoucherTag|BossTag|StandardTag|CharmTag|MeteorTag|BuffoonTag|HandyTag|GarbageTag|EtherealTag|CouponTag|DoubleTag|JuggleTag|D6Tag|TopupTag|SpeedTag|OrbitalTag|EconomyTag)\\b",
      "name": "support.type.tag.jaml"
    },
    "planet-name": {
      "match": "\\b(Mercury|Venus|Earth|Mars|Jupiter|Saturn|Uranus|Neptune|Pluto|PlanetX|Ceres|Eris)\\b",
      "name": "support.type.planet.jaml"
    },
    "event-name": {
      "match": "\\b(LuckyMoney|LuckyMult|MisprintMult|WheelOfFortune|CavendishExtinct|GrosMichelExtinct|SpaceLevelup|BusinessPayout|BloodstoneTrigger|ParkingPayout|GlassDestroy|WheelStaysFlipped)\\b",
      "name": "support.type.event.jaml"
    },
    "card-shorthand": {
      "match": "\\b([CDHS](?:10|[2-9TJQKA])|(?:10|[2-9TJQKA])[CDHS])\\b",
      "name": "string.unquoted.card.jaml"
    },
    "edition": {
      "match": "\\b(Base|Foil|Holographic|Polychrome|Negative)\\b",
      "name": "support.constant.edition.jaml"
    },
    "sticker": {
      "match": "\\b(Eternal|Perishable|Rental)\\b",
      "name": "support.constant.sticker.jaml"
    },
    "seal": {
      "match": "(?<=seal:\\s*)(Gold|Red|Blue|Purple)\\b",
      "name": "support.constant.seal.jaml"
    },
    "enhancement": {
      "match": "(?<=enhancement:\\s*)(Bonus|Mult|Wild|Glass|Steel|Stone|Gold|Lucky)\\b",
      "name": "support.constant.enhancement.jaml"
    },
    "deck-stake": {
      "patterns": [
        {
          "match": "(?<=deck:\\s*)(Red|Blue|Yellow|Green|Black|Magic|Nebula|Ghost|Abandoned|Checkered|Zodiac|Painted|Anaglyph|Plasma|Erratic)\\b",
          "name": "support.constant.deck.jaml"
        },
        {
          "match": "(?<=stake:\\s*)(White|Red|Green|Black|Blue|Purple|Orange|Gold)\\b",
          "name": "support.constant.stake.jaml"
        }
      ]
    },
    "constant": {
      "match": "\\b(true|false|null|any|Any)\\b",
      "name": "constant.language.jaml"
    },
    "aesthetic": {
      "match": "\\b(palindrome|psychosis|gross|nsfw|funny|balatro)\\b",
      "name": "string.unquoted.aesthetic.jaml"
    },
    "string-quoted": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.jaml"
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.jaml"
        }
      ]
    },
    "number": {
      "match": "\\b-?\\d+\\b",
      "name": "constant.numeric.jaml"
    },
    "punctuation": {
      "patterns": [
        {
          "match": "^\\s*-\\s",
          "name": "punctuation.definition.list.jaml"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.definition.array.jaml"
        }
      ]
    }
  }
}