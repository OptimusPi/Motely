name: Stone Card — +50 chips
author: corpus
description: >-
  Stone Card gives +50 Chips and has no rank or suit. First-shop card engine: pair with
  Stone Joker, Marble Joker, Splash, and Blackboard.
deck: Red
stake: White
must:
  - standardCard:
      enhancement: Stone
      antes: [1]
      sources:
        shopItems: [0, 1, 2, 3]
        boosterPacks: [0, 1]
should:
  - joker: StoneJoker
    antes: [1, 2, 3]
    score: 45
  - joker: MarbleJoker
    antes: [1, 2, 3]
    score: 40
  - joker: Splash
    antes: [1, 2, 3]
    score: 35
