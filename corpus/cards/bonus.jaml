name: Bonus Card — +30 chips
author: corpus
description: >-
  Bonus Card gives +30 Chips when scored. First-shop card engine: pair with Hiker, Blue
  Joker, and Splash.
deck: Red
stake: White
must:
  - standardCard:
      enhancement: Bonus
      antes: [1]
      sources:
        shopItems: [0, 1, 2, 3]
        boosterPacks: [0, 1]
should:
