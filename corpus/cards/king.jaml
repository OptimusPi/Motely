name: King — face card
author: corpus
description: >-
  Kings are face cards. First-shop card engine: pair with Baron, Mime, Pareidolia, and any
  face-card payoff.
deck: Red
stake: White
must:
  - standardCard:
      rank: K
      antes: [1]
      sources:
        shopItems: [0, 1, 2, 3]
        boosterPacks: [0, 1]
should:
  - joker: Baron
    antes: [1, 2, 3]
    score: 45
  - joker: Mime
    antes: [1, 2, 3]
    score: 40
  - joker: Pareidolia
    antes: [1, 2, 3]
    score: 35
