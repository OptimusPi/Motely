name: The Sun — heart conversion
author: corpus
description: >-
  The Sun converts up to 3 selected cards to Hearts. First-shop heart engine: pair with
  Lusty Joker, Bloodstone, and Smeared Joker.
deck: Red
stake: White
must:
  - tarotCard: TheSun
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: LustyJoker
    antes: [1, 2, 3]
    score: 45
  - joker: Bloodstone
    antes: [1, 2, 3]
    score: 35
  - joker: SmearedJoker
    antes: [1, 2, 3]
    score: 25
