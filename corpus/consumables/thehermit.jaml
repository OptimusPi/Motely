name: The Hermit — money doubler
author: corpus
description: >-
  The Hermit doubles your current money (max $20). First-shop economy: pair with To the
  Moon, Bull, and Rocket to maximize the doubled amount.
deck: Red
stake: White
must:
  - tarotCard: TheHermit
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: ToTheMoon
    antes: [1, 2, 3]
    score: 45
  - joker: Bull
    antes: [1, 2, 3]
    score: 35
  - joker: Rocket
    antes: [1, 2, 3]
    score: 30
