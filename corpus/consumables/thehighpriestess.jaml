name: The High Priestess — planet generator
author: corpus
description: >-
  The High Priestess creates up to 2 random Planet cards. First-shop planet engine: pair
  with Constellation, Astronomer, and Perkeo to duplicate planets.
deck: Red
stake: White
must:
  - tarotCard: TheHighPriestess
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: Constellation
    antes: [1, 2, 3]
    score: 45
  - joker: Astronomer
    antes: [1, 2, 3]
    score: 35
  - joker: Perkeo
    antes: [1, 2, 3]
    score: 30
