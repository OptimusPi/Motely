name: The Soul — legendary joker
author: corpus
description: >-
  The Soul creates a Legendary Joker (must have room). First-shop legendary access: pair
  with Perkeo (duplicate The Soul), Showman, and any legendary target.
deck: Red
stake: White
must:
  - spectralCard: TheSoul
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: Perkeo
    antes: [1, 2, 3]
    score: 45
  - joker: Showman
    antes: [1, 2, 3]
    score: 35
  - legendaryJoker: Triboulet
    antes: [1, 2, 3]
    score: 30
