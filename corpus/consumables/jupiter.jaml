    antes: [1, 2, 3]
    score: 45
  - joker: CraftyJoker
    antes: [1, 2, 3]
    score: 35
  - joker: TheTribe
    antes: [1, 2, 3]
    score: 30
  - joker: SmearedJoker
    antes: [1, 2, 3]
    score: 25
