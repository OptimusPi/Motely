name: The Devil — gold card
author: corpus
description: >-
  The Devil enhances 1 selected card into a Gold Card. First-shop gold economy: pair with
  Golden Ticket, Midas Mask, and Pareidolia.
deck: Red
stake: White
must:
  - tarotCard: TheDevil
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: GoldenTicket
    antes: [1, 2, 3]
    score: 45
  - joker: MidasMask
    antes: [1, 2, 3]
    score: 40
  - joker: Pareidolia
    antes: [1, 2, 3]
    score: 30
