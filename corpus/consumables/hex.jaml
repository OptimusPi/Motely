name: Hex — polychrome joker
author: corpus
description: >-
  Hex adds Polychrome to a random Joker, then destroys all other Jokers. First-shop
  spectral edition engine: place a single strong joker and give it Polychrome.
deck: Red
stake: White
must:
  - spectralCard: Hex
    antes: [1]
    sources:
      boosterPacks: [0, 1]
should:
  - joker: TheOrder
    antes: [1, 2, 3]
    score: 40
  - joker: Cavendish
    antes: [1, 2, 3]
    score: 40
  - joker: TheTribe
    antes: [1, 2, 3]
    score: 30
