name: Familiar — face-card generator
author: corpus
description: >-
  Familiar destroys 1 random card, then adds 3 random Enhanced Face cards to the deck.
  First-shop spectral face engine: pair with Pareidolia, Smiley Face, Sock and Buskin.
deck: Red
stake: White
must:
  - spectralCard: Familiar
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: Pareidolia
    antes: [1, 2, 3]
    score: 45
  - joker: SmileyFace
    antes: [1, 2, 3]
    score: 40
  - joker: SockAndBuskin
    antes: [1, 2, 3]
    score: 30
