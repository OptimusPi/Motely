name: The Emperor — tarot generator
author: corpus
description: >-
  The Emperor creates up to 2 random Tarot cards. First-shop tarot engine: pair with
  Fortune Teller, The Fool, and Perkeo.
deck: Red
stake: White
must:
  - tarotCard: TheEmperor
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: FortuneTeller
    antes: [1, 2, 3]
    score: 45
  - tarotCard: TheFool
    antes: [1, 2, 3]
    score: 40
  - joker: Perkeo
    antes: [1, 2, 3]
    score: 30
