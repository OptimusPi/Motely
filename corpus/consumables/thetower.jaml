name: The Tower — stone card
author: corpus
description: >-
  The Tower enhances 1 selected card into a Stone Card. First-shop stone engine: pair with
  Stone Joker, Marble Joker, Splash, and Blackboard.
deck: Red
stake: White
must:
  - tarotCard: TheTower
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: StoneJoker
    antes: [1, 2, 3]
    score: 45
  - joker: MarbleJoker
    antes: [1, 2, 3]
    score: 40
  - joker: Splash
    antes: [1, 2, 3]
    score: 30
