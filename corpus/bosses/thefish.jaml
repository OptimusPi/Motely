name: The Fish — first hand face down
author: corpus
description: >-
  The Fish draws the first hand of the round face down. Ante 2 boss: rely on hand-size and
  stable poker hands; Luchador/Chicot remove the risk.
deck: Red
stake: White
must:
  - boss: TheFish
    antes: [2]
should:
  - joker: Luchador
    antes: [1, 2, 3]
    score: 45
  - joker: Chicot
    antes: [1, 2, 3]
    score: 40
  - joker: Juggler
    antes: [1, 2, 3]
    score: 25
