name: Holographic Tag — free holographic joker
author: corpus
description: >-
  Holographic Tag makes the next base-edition Joker in a shop become Holographic (+10
  Mult) and free. First-shop skip reward: pair with mult-scaling jokers and Showman.
deck: Red
stake: White
must:
  - tag: HolographicTag
    antes: [1]
    sources:
      tags: true
should:
  - joker: JollyJoker
    antes: [1, 2, 3]
    score: 40
  - joker: ZanyJoker
    antes: [1, 2, 3]
    score: 40
  - joker: Showman
    antes: [1, 2, 3]
    score: 25
