name: Constellation — planet-scaling mult
author: corpus
description: >-
  Constellation gains X0.1 Mult every time a Planet card is used. First-shop scaling:
  pair with Planet sources (Astronomer, Satellite, Cartomancer, Celestial packs) and
  Perkeo for duplicating the key Planet.
deck: Red
stake: White
must:
  - joker: Constellation
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: Astronomer
    antes: [1, 2, 3]
    score: 45
  - joker: Satellite
    antes: [1, 2, 3]
    score: 35
  - joker: Cartomancer
    antes: [1, 2, 3]
    score: 30
  - joker: Perkeo
    antes: [1, 2, 3]
    score: 25
