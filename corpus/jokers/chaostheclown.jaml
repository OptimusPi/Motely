name: Chaos the Clown — free reroll
author: corpus
description: >-
  Chaos the Clown gives 1 free reroll per shop. First-shop tempo/economy: feeds
  Flash Card (+2 Mult per reroll) and lets you dig the first shop for synergy pieces
  without spending.
deck: Red
stake: White
must:
  - joker: ChaostheClown
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: FlashCard
    antes: [1, 2, 3]
    score: 40
  - joker: Blueprint
    antes: [1, 2]
    score: 20
