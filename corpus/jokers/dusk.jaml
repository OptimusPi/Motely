name: Dusk — final-hand retrigger
author: corpus
description: >-
  Dusk retriggers all played cards in the final hand of the round. First-shop retrigger
  engine: best with high-value cards, Glass, Photograph, and held-in-hand effects.
deck: Red
stake: White
must:
  - joker: Dusk
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: Photograph
    antes: [1, 2, 3]
    score: 35
  - joker: HangingChad
    antes: [1, 2, 3]
    score: 30
  - joker: Hack
    antes: [1, 2, 3]
    score: 25
