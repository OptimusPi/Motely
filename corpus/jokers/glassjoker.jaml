name: Glass Joker — glass-destroy X-mult
author: corpus
description: >-
  Glass Joker gains X0.75 Mult for every Glass card destroyed. First-shop scaling X-mult:
  create Glass cards via Justice tarot (1 card, 1/4 destroy on score). Oops All 6s doubles
  destruction rate from 1/4 to 2/4 — faster stacking. Seltzer retriggers for more procs.
deck: Red
stake: White
must:
  - joker: GlassJoker
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - tarotCard: Justice
    antes: [1, 2, 3]
    score: 45
    label: "Justice (creates 1 Glass card — core enabler)"
  - joker: OopsAll6s
    antes: [1, 2, 3]
    score: 40
    label: "OopsAll6s (doubles glass break rate to 50%)"
  - joker: Seltzer
    antes: [1, 2, 3]
    score: 25
  - joker: Showman
    antes: [1, 2, 3]
    score: 20
