name: Merry Andy — discard engine
author: corpus
description: >-
  Merry Andy gives +3 discards each round and reduces hand size by 1. First-shop discard
  engine: powers Banner, Castle, Faceless Joker, Mail-In Rebate, and Trading Card.
deck: Red
stake: White
must:
  - joker: MerryAndy
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: Banner
    antes: [1, 2, 3]
    score: 45
  - joker: Castle
    antes: [1, 2, 3]
    score: 40
  - joker: FacelessJoker
    antes: [1, 2, 3]
    score: 35
