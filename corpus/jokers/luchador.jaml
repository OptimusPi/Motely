name: Luchador — boss disable
author: corpus
description: >-
  Sell Luchador to disable the current Boss Blind. First-shop utility: pick it up for
  boss safety, and sell when a build-killer boss appears (e.g. The Flint, Verdant Leaf,
  Amber Acorn).
deck: Red
stake: White
must:
  - joker: Luchador
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: Matador
    antes: [1, 2, 3]
    score: 35
  - joker: Chicot
    antes: [1, 2, 3]
    score: 30
  - joker: GiftCard
    antes: [1, 2, 3]
    score: 20
