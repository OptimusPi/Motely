name: Sly Joker — pair chips
author: corpus
description: >-
  Sly Joker gives +50 Chips if the hand contains a Pair. First-shop pair chips:
  the chip counterpart to Jolly Joker — run both for chips+mult on the same Pair,
  level Pairs with Mercury.
deck: Red
stake: White
must:
  - joker: SlyJoker
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: JollyJoker
    antes: [1, 2]
    score: 35
  - joker: TheDuo
    antes: [1, 2, 3]
    score: 30
  - planetCard: Mercury
    antes: [1, 2]
    score: 20
