name: Blue Deck — hand engine
author: corpus
description: >-
  Blue Deck gives +1 hand every round. First-shop synergy: find a hand-based scaling joker
  in Ante 1's first shop.
deck: Blue
stake: White
must:
  - joker: GreenJoker
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: RideTheBus
    antes: [1, 2, 3]
    score: 45
  - joker: LoyaltyCard
    antes: [1, 2, 3]
    score: 40
  - voucher: Grabber
    antes: [1, 2, 3]
    score: 30
