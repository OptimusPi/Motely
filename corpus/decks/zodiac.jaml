name: Zodiac Deck — merchant vouchers
author: corpus
description: >-
  Zodiac Deck starts with Tarot Merchant, Planet Merchant, and Overstock. First-shop synergy:
  find a tarot/planet generator or shop-discount joker.
deck: Zodiac
stake: White
must:
  - joker: FortuneTeller
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: Constellation
    antes: [1, 2, 3]
    score: 45
  - joker: Cartomancer
    antes: [1, 2, 3]
    score: 40
  - joker: Supernova
    antes: [1, 2, 3]
    score: 30
