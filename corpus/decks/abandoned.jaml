name: Abandoned Deck — no face cards
author: corpus
description: >-
  Abandoned Deck starts with no Face Cards. First-shop synergy: number-based jokers (Even
  Steven, Fibonacci, Hack) dominate.
deck: Abandoned
stake: White
must:
  - joker: EvenSteven
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: Fibonacci
    antes: [1, 2, 3]
    score: 45
  - joker: Hack
    antes: [1, 2, 3]
    score: 40
  - spectralCard: Incantation
    antes: [1, 2, 3]
    score: 25
