name: Red Deck — discard engine
author: corpus
description: >-
  Red Deck gives +1 discard every round. First-shop synergy: find a discard payoff joker
  or voucher in Ante 1's first shop.
deck: Red
stake: White
must:
  - joker: Drunkard
    antes: [1]
    sources:
      shopItems: [0, 1, 2, 3]
      boosterPacks: [0, 1]
should:
  - joker: Castle
    antes: [1, 2, 3]
    score: 45
  - joker: MerryAndy
    antes: [1, 2, 3]
    score: 40
  - voucher: Wasteful
    antes: [1, 2, 3]
    score: 30
