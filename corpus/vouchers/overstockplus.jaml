name: Overstock Plus — max shop slots
author: corpus
description: >-
  Overstock Plus adds +1 more card slot (to 4) and immediately restocks empty slots. First-shop
  economy: best after Overstock, and pairs with any shop-reroll/shop-spam strategy.
deck: Red
stake: White
must:
  - voucher: OverstockPlus
    antes: [2]
    sources:
      shopItems: [0, 1, 2, 3]
should:
  - voucher: RerollSurplus
    antes: [1, 2, 3]
    score: 35
  - joker: FlashCard
    antes: [1, 2, 3]
    score: 30
  - joker: ChaostheClown
    antes: [1, 2, 3]
    score: 25
