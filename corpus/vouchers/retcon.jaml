name: Retcon — unlimited boss reroll
author: corpus
description: >-
  Retcon allows unlimited Boss Blind rerolls for $10 each. First-shop boss control: pair
  with Matador, Luchador, and Chicot.
deck: Red
stake: White
must:
  - voucher: Retcon
    antes: [2]
    sources:
      shopItems: [0, 1, 2, 3]
should:
  - joker: Matador
    antes: [1, 2, 3]
    score: 45
  - joker: Luchador
    antes: [1, 2, 3]
    score: 40
  - joker: Chicot
    antes: [1, 2, 3]
    score: 35
