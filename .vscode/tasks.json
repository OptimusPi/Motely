{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "dotnet build ${workspaceFolder}/Motely.sln --configuration Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Motely: Run JSON Search with Split Output",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project", "${workspaceFolder}/Motely.Run/Motely.Run.csproj",
                "--",
                "--json", "${input:configName}",
                "--endBatch", "${input:endBatch}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Motely",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Motely: Run with CSV Output to File",
            "type": "shell",
            "command": "cmd.exe /c \"dotnet run --project Motely.Run -- --json ${input:configName} --endBatch ${input:endBatch} > results.csv 2> progress.log\"",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Motely: Watch Progress Log",
            "type": "shell",
            "command": "cmd.exe /c \"powershell -Command 'Get-Content progress.log -Wait -Tail 20'\"",
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Motely: Watch CSV Output",
            "type": "shell",
            "command": "cmd.exe /c \"powershell -Command 'Get-Content results.csv -Wait -Tail 50'\"",
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Motely: Run and Monitor (All Streams)",
            "dependsOn": [
                "Motely: Run with CSV Output to File",
                "Motely: Watch Progress Log",
                "Motely: Watch CSV Output"
            ],
            "dependsOrder": "parallel",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "configName",
            "type": "promptString",
            "description": "JSON config name (e.g., 'nate', 'standard')",
            "default": "nate"
        },
        {
            "id": "endBatch",
            "type": "promptString",
            "description": "End batch number (0 = unlimited)",
            "default": "100000"
        }
    ]
}
