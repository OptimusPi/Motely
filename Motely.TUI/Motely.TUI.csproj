<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Performance optimizations -->
    <Optimize>true</Optimize>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <EnableHardwareIntrinsics>true</EnableHardwareIntrinsics>
    <EnableAVX2>true</EnableAVX2>
    <EnableAVX512F>true</EnableAVX512F>
    <EnableAVX512BW>true</EnableAVX512BW>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>MotelyTUI</AssemblyName>
    <NoWarn>$(NoWarn)</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="Terminal.Gui" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
    <!-- ApiServerWindow launches the REAL API (HelperApiHost.Build) instead of building its own
         second copy — this is what makes that possible, and what let Swashbuckle/OpenApi (and
         the CVE they dragged in) come out of the TUI entirely. -->
    <ProjectReference Include="..\Motely.HelperAPI\Motely.HelperAPI.csproj" />
    <!-- SearchWindow uses SeedSourceProvider for file-source searches. -->
    <ProjectReference Include="..\Motely.DataLake\Motely.DataLake.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Jimbo.png" />
  </ItemGroup>
</Project>
