<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The frontier model IS the brain. This MCP server is the bridge: it exposes the
         REAL Motely engine over stdio so the client (Claude) can validate JAML and run
         bounded searches in-process. No Vercel, no money hole, no lesser embedded AI. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
    <ProjectReference Include="..\Motely.Data\Motely.Data.csproj" />
  </ItemGroup>

</Project>
