{
  "name": "jaml-seed-lab",
  "version": "0.1.0",
  "description": "Balatro seed finder, analyzer, and JAML IDE — a composable Next.js app ecosystem powered by motely-wasm, json-render, and jaml-ui.",
  "author": "pifreak",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptimusPi/jaml-seed-lab.git"
  },
  "bugs": {
    "url": "https://github.com/OptimusPi/jaml-seed-lab/issues"
  },
  "homepage": "https://github.com/OptimusPi/jaml-seed-lab#readme",
  "type": "module",
  "bin": {
    "jaml-seed": "./bin/cli.mjs",
    "jsl": "./bin/cli.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./apps/ide": {
      "types": "./dist/apps/ide/index.d.ts",
      "default": "./dist/apps/ide/index.js"
    },
    "./apps/home": {
      "types": "./dist/apps/home/index.d.ts",
      "default": "./dist/apps/home/index.js"
    },
    "./apps/finder": {
      "types": "./dist/apps/finder/index.d.ts",
      "default": "./dist/apps/finder/index.js"
    },
    "./apps/analyzer": {
      "types": "./dist/apps/analyzer/index.d.ts",
      "default": "./dist/apps/analyzer/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./spec-builder": {
      "types": "./dist/spec-builder.d.ts",
      "default": "./dist/spec-builder.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./codemirror": {
      "types": "./dist/codemirror/index.d.ts",
      "default": "./dist/codemirror/index.js"
    },
    "./next": {
      "types": "./next.config.d.ts",
      "default": "./next.config.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "app",
    "public",
    "next.config.ts",
    "tsconfig.json",
    "postcss.config.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build:lib && npm run typecheck",
    "publish:public": "npm publish --access public",
    "publish:beta": "npm publish --access public --tag beta"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "jaml-ui": "^2.0.0",
    "motely-wasm": ">=19.4.0",
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@json-render/shadcn": "^0.19.0",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jaml-lang": "^0.1.2",
    "lucide-react": "^1.16.0",
    "react-icons": "^5.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.0",
    "jaml-ui": "^2.0.0",
    "motely-wasm": ">=19.4.0",
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "balatro",
    "seed",
    "seed-finder",
    "jaml",
    "motely",
    "json-render",
    "jaml-ui",
    "balatro-seeds",
    "erratic-deck",
    "game-analysis",
    "mcp",
    "lsp"
  ]
}
