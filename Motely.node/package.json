{
  "name": "motely-node",
  "version": "3.1.4",
  "description": "MotelyJAML for Node.js - Balatro seed analyzer and JAML filter engine using .NET 10 Native AOT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.cjs",
      "types": "./index.d.ts"
    },
    "./server": {
      "import": "./server.js",
      "require": "./server.cjs",
      "types": "./server.d.ts"
    },
    "./jaml-schema": {
      "import": "./jaml-schema.js",
      "types": "./jaml-schema.d.ts"
    },
    "./jaml.schema.json": "./jaml.schema.json"
  },
  "files": [
    "bin/",
    "index.js",
    "index.cjs",
    "index.d.ts",
    "server.js",
    "server.cjs",
    "server.d.ts",
    "jaml-schema.js",
    "jaml-schema.d.ts",
    "jaml.schema.json",
    "README.md"
  ],
  "keywords": [
    "balatro",
    "seed",
    "dotnet",
    "node-api",
    "aot",
    "jaml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptimusPi/MotelyJAML.git",
    "directory": "Motely.node"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
