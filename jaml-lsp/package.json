{
  "name": "jaml-language-support",
  "displayName": "Jimbo's Ante Markup Language",
  "description": "JAML syntax highlighting, schema validation, completions, and diagnostics for .jaml filter files.",
  "version": "2.0.0",
  "publisher": "pifreak",
  "license": "MIT",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/OptimusPi/MotelyJAML"
  },
  "extensionDependencies": [],
  "extensionRecommendations": [
    "redhat.vscode-yaml"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jaml",
        "aliases": [
          "JAML",
          "jaml"
        ],
        "extensions": [
          ".jaml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jummy",
        "aliases": [
          "Jummy",
          "jummy"
        ],
        "extensions": [
          ".jummy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jaml",
        "scopeName": "source.jaml",
        "path": "./syntaxes/jaml.tmLanguage.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "*.jaml"
        ],
        "url": "./schemas/jaml.schema.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "*.jaml"
        ],
        "url": "./schemas/jaml.schema.json"
      }
    ],
    "snippets": [
      {
        "language": "jaml",
        "path": "./snippets/jaml.json"
      }
    ],
    "chatParticipants": [
      {
        "id": "jimbo.chat",
        "name": "jimbo",
        "fullName": "Jimbo",
        "description": "Ask about JAML syntax, get help writing or explaining Balatro seed-filter clauses.",
        "isSticky": true
      }
    ],
    "notebooks": [
      {
        "type": "jaml-notebook",
        "displayName": "JAML Seed Search Notebook",
        "selector": [
          {
            "filenamePattern": "*.jamlnb"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "jaml.runSearch",
        "title": "JAML: Run Seed Search",
        "category": "JAML"
      },
      {
        "command": "jaml.stopSearch",
        "title": "JAML: Stop Seed Search",
        "category": "JAML"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "jaml.runSearch",
          "when": "resourceLangId == jaml || resourceLangId == jummy",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "jaml.runSearch",
        "key": "ctrl+enter",
        "when": "editorTextFocus && (resourceLangId == jaml || resourceLangId == jummy)"
      }
    ],
    "configuration": {
      "title": "JAML",
      "properties": {
        "jaml.validate": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time JAML diagnostics."
        }
      }
    }
  },
  "bin": {
    "jaml-language-server": "./dist/server.js"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check-types": "tsc --noEmit",
    "vscode:prepublish": "npm run check-types && npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "jaml-lang": "file:../jaml-lang",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.97.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
