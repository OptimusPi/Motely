{
  "name": "jaml-lsp",
  "displayName": "JAML — Balatro seed filters",
  "description": "Language support for .jaml seed filters: completion, diagnostics, hover, and outline, powered by the @motely/jaml-lang contract and the Motely engine.",
  "version": "0.1.0",
  "publisher": "motely",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./out/client/extension.js",
  "activationEvents": [
    "onLanguage:jaml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jaml",
        "aliases": [
          "JAML",
          "jaml"
        ],
        "extensions": [
          ".jaml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jaml",
        "scopeName": "source.jaml",
        "path": "./syntaxes/jaml.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "JAML",
      "properties": {
        "jaml.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the JAML language server."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "dependencies": {
    "@motely/jaml-lang": "file:../jaml-lang",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "yaml": "^2.5.0",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "motely-wasm": "*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.9.2"
  }
}
