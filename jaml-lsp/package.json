{
  "name": "jaml-language-support",
  "displayName": "JAML — Jimbo's Ante Markup Language",
  "description": "Language support for JAML (Balatro/Motely seed filters): diagnostics, completion, hover, and document symbols, powered by the engine-generated jaml-lang service.",
  "version": "0.1.0",
  "publisher": "pifreak",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": ["Programming Languages", "Linters"],
  "keywords": ["balatro", "jaml", "motely", "lsp", "seed-filter"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptimusPi/MotelyJAML.git",
    "directory": "jaml-lsp"
  },
  "main": "./dist/extension.js",
  "bin": {
    "jaml-language-server": "./dist/server.js"
  },
  "activationEvents": ["onLanguage:jaml"],
  "contributes": {
    "languages": [
      {
        "id": "jaml",
        "aliases": ["JAML", "jaml"],
        "extensions": [".jaml"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jaml",
        "scopeName": "source.jaml",
        "path": "./syntaxes/jaml.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "JAML",
      "properties": {
        "jaml.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace the communication between VS Code and the JAML language server."
        }
      }
    }
  },
  "scripts": {
    "bundle": "node esbuild.mjs",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "smoke": "tsx test/protocol-smoke.ts",
    "vscode:prepublish": "node esbuild.mjs"
  },
  "dependencies": {
    "jaml-lang": "file:../jaml-lang",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
