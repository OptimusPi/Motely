# Everything is bundled into dist/ by esbuild, so ship only what the extension
# needs at runtime. Keeps the .vsix tiny and free of the file: jaml-lang dep.
.vscode/**
.github/**
node_modules/**
src/**
test/**
**/*.ts
**/*.map
tsconfig.json
esbuild.mjs
package-lock.json
.gitignore
.vscodeignore
**/.DS_Store
