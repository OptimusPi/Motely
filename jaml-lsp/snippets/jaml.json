{
  "JAML Filter skeleton": {
    "prefix": "jaml",
    "body": [
      "id: ${1:my_filter}",
      "name: \"${2:My Filter}\"",
      "author: \"${3:Your Name}\"",
      "deck: ${4:Red}",
      "stake: ${5:White}",
      "",
      "must:",
      "  - ${6:joker}: ${7:Blueprint}",
      "",
      "should:",
      "  - ${8:boss}: ${9:ThePsychic}",
      "    score: ${10:100}"
    ],
    "description": "Blank JAML filter"
  },
  "must clause": {
    "prefix": "must",
    "body": ["must:", "  - ${1:joker}: ${2:Blueprint}"],
    "description": "must: list"
  },
  "should clause": {
    "prefix": "should",
    "body": ["should:", "  - ${1:joker}: ${2:Blueprint}", "    score: ${3:50}"],
    "description": "should: list with score"
  },
  "mustNot clause": {
    "prefix": "mustNot",
    "body": ["mustNot:", "  - ${1:boss}: ${2:TheEye}"],
    "description": "mustNot: list"
  },
  "joker clause": {
    "prefix": "joker",
    "body": [
      "- joker: ${1:Blueprint}",
      "  ante: ${2:1}",
      "  edition: ${3:Foil}"
    ],
    "description": "Joker clause"
  },
  "boss clause": {
    "prefix": "boss",
    "body": ["- boss: ${1:TheEye}", "  ante: ${2:1}"],
    "description": "Boss blind clause"
  },
  "tag clause": {
    "prefix": "tag",
    "body": ["- tag: ${1:NegativeTag}", "  ante: ${2:1}"],
    "description": "Tag clause"
  }
}
