<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    No <clear /> on purpose: lets per-user NuGet.Config sources merge in.
    Bootsharp.FileSystem (sponsor) is NOT on nuget.org — add it at user level only:
      macOS/Linux: ~/.config/NuGet/NuGet.Config
      Windows: %APPDATA%\NuGet\NuGet.Config
    Full steps: Motely.Wasm/SETUP-macos-rewaffle.md
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
