<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    No <clear /> on purpose: lets per-user NuGet.Config sources merge in.
    Local Bootsharp alpha feed is added at the user level, not committed:
      Windows: %APPDATA%\NuGet\NuGet.Config
      macOS/Linux: ~/.config/NuGet/NuGet.Config
    Add entries pointing at wherever you cloned Bootsharp's .nuget output.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bootsharp-local" value="D:\bootsharp\src\cs\.nuget" />
    <add key="extra-local" value="D:\extra\bootsharp\cs\.nuget" />
  </packageSources>
</configuration>
