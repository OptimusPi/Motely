<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- AOT Build - NO THREADS for Node.js compatibility -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmEnableThreads>false</WasmEnableThreads>
    <WasmEnableSIMD>true</WasmEnableSIMD>

    <!-- Trimming & Optimization -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>

    <!-- Size Reduction -->
    <WasmIncludeFullSymbols>false</WasmIncludeFullSymbols>
    <WasmDebugLevel>0</WasmDebugLevel>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <WasmEmitCompressedAssets>false</WasmEmitCompressedAssets>
    <BlazorEnableCompression>false</BlazorEnableCompression>

    <!-- No ICU data needed -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorWebAssemblyPreserveCollationData>false</BlazorWebAssemblyPreserveCollationData>

    <!-- Skip wasm-opt -->
    <WasmRunWasmOpt>false</WasmRunWasmOpt>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>

  <Target Name="CopyToNodePackage" AfterTargets="Publish">
    <PropertyGroup>
      <_NodeFrameworkPath>$(MSBuildThisFileDirectory)..\Motely.node\_framework</_NodeFrameworkPath>
    </PropertyGroup>
    <Message Importance="high" Text="Copying WASM to Motely.node/_framework..." />
    <RemoveDir Directories="$(_NodeFrameworkPath)" />
    <MakeDir Directories="$(_NodeFrameworkPath)" />
    <ItemGroup>
      <_FrameworkFiles Include="$(PublishDir)wwwroot\_framework\**\*" 
                       Exclude="$(PublishDir)wwwroot\_framework\debug\**\*;$(PublishDir)wwwroot\_framework\tmp\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FrameworkFiles)" 
          DestinationFiles="@(_FrameworkFiles->'$(_NodeFrameworkPath)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
