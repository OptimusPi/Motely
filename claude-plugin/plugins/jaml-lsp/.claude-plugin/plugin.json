{
  "name": "jaml-lsp",
  "description": "LSP for JAML .jaml filters — diagnostics, completions, and hover, generated from Motely's own clause registry. Bundled self-contained; no separate install.",
  "version": "1.1.0",
  "author": { "name": "pifreak" },
  "license": "MIT",
  "repository": "https://github.com/OptimusPi/MotelyJAML",
  "keywords": ["jaml", "balatro", "motely", "lsp"],
  "lspServers": {
    "jaml": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/server.js", "--stdio"],
      "transport": "stdio",
      "extensionToLanguage": {
        ".jaml": "jaml"
      }
    }
  }
}
