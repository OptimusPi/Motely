<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>Motely.Lsp</AssemblyName>

    <!-- Packed as a .NET tool so the Claude Code plugin can run it as
         `dotnet dnx -y MotelyJAML.Lsp` — no absolute paths, no bin/Debug,
         works on any machine that installs the plugin. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>motely-lsp</ToolCommandName>
    <PackageId>MotelyJAML.Lsp</PackageId>
    <Description>JAML language server — diagnostics, hover, and completion computed off the Motely engine grammar.</Description>
    <Authors>pifreak</Authors>
    <PackageTags>jaml;lsp;balatro;motely</PackageTags>
    <!-- Hand-rolled JSON-RPC 2.0 over stdio. Thin shell: every answer comes from
         Motely.Lsp.Core to the Motely engine. Publish self-contained for the VS Code extension:
         dotnet publish Motely.Lsp -c Release -r osx-arm64 -p:SelfContained=true -p:PublishSingleFile=true -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely.Lsp.Core\Motely.Lsp.Core.csproj" />
  </ItemGroup>

</Project>
