<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The JAML language server: JSON-RPC 2.0 over stdio, hand-rolled on purpose. LSP's
         transport is ~50 lines of Content-Length framing, and owning it keeps the server a
         plain, dependency-free exe that publishes self-contained for the Claude Code plugin:
         dotnet publish Motely.Lsp -c Release -r win-x64 -\-self-contained -p:PublishSingleFile=true -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely.Lsp.Core\Motely.Lsp.Core.csproj" />
  </ItemGroup>

</Project>
